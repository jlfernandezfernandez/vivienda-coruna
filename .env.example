# Runtime
NODE_ENV=development
DB_PATH=./src/data/monitor.db
BACKEND_INTERNAL_URL=http://127.0.0.1:3000
OPERATIONS_API_KEY=change-me-with-at-least-32-random-bytes

# Firecrawl compartido. La clave es opcional en instalaciones self-hosted sin auth.
FIRECRAWL_BASE_URL=http://192.168.0.74:3002
FIRECRAWL_API_KEY=

# Extracción LLM opcional mediante un endpoint compatible con OpenAI.
# Por seguridad no hay proveedor, URL ni modelo implícitos: configure las tres variables juntas.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Solo Compose de producción. Debe ser una etiqueta inmutable sha-<commit>.
IMAGE_TAG=
