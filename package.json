{
  "name": "vivienda-coruna",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test": "LLM_API_KEY=test LLM_BASE_URL=http://llm.invalid LLM_MODEL=test-model node --test tests/*.test.mjs",
    "refresh": "node scripts/fetch-rss.mjs",
    "refresh:fast": "FAST_REFRESH=1 node scripts/fetch-rss.mjs",
    "refresh:all": "node scripts/fetch-rss.mjs && node scripts/enrich-firecrawl.mjs",
    "enrich": "node scripts/enrich-firecrawl.mjs",
    "enrich:retry": "RETRY_ONLY=1 node scripts/enrich-firecrawl.mjs",
    "quality": "node scripts/quality-gate.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/node": "11.0.3",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.1",
    "fastify": "5.10.0",
    "leaflet": "^1.9.4",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
