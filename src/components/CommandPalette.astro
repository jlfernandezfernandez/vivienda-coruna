---
import { api } from '../lib/api/client.mjs';
import { apiSafe } from '../lib/api/boundary.mjs';
import { siteBase } from '../lib/ui.mjs';

interface Props {
  items?: Array<{
    id: string;
    title: string;
    category?: string;
    type?: string;
    status?: string | null;
    precioMin?: number | null;
    municipality?: string | null;
    barrio?: string | null;
    url?: string;
  }>;
}

const base = siteBase(import.meta.env.BASE_URL);
let { items } = Astro.props;

if (!items || items.length === 0) {
  const dashboard = await apiSafe(Astro.response, () => api.dashboard(), {
    opportunities: [],
    sources: [],
    gestoras: [],
    cooperatives: [],
    events: [],
    municipalities: [],
    coverage: { boundaries: [], markers: [] },
  });

  const oppItems = (dashboard.opportunities || []).map((op: any) => ({
    id: op.id,
    title: op.nombrePromocion || op.title,
    category: op.type || 'Obra Nueva',
    type: op.type || 'Obra Nueva',
    status: op.status || null,
    precioMin: op.precioMin || null,
    municipality: op.municipality || op.location || null,
    barrio: op.barrio || null,
    url: `${base}oportunidad/${op.id}`,
  }));

  const promoItems = (dashboard.gestoras || []).flatMap((g: any) =>
    (g.promotions || []).map((pr: any) => ({
      id: pr.id,
      title: pr.name,
      category: pr.buscaSocios === true ? 'Cooperativa' : 'Obra Nueva',
      type: pr.buscaSocios === true ? 'Cooperativa' : 'Promoción',
      status: pr.status || null,
      precioMin: pr.aportacionInicial ? pr.aportacionInicial * 4 : null,
      municipality: pr.municipality || pr.location || null,
      barrio: pr.barrio || null,
      url: `${base}gestora/${pr.gestoraId || g.id}`,
    }))
  );

  items = [...oppItems, ...promoItems];
}
---

<div
  id="cmd-palette-backdrop"
  class="fixed inset-0 bg-ink/40 backdrop-blur-sm z-50 hidden opacity-0 transition-opacity duration-150 flex items-start justify-center pt-16 sm:pt-24 px-4"
  role="dialog"
  aria-modal="true"
  aria-label="Buscador global"
>
  <div
    id="cmd-palette-modal"
    class="w-full max-w-xl bg-surface border border-border-medium rounded-2xl shadow-hover overflow-hidden flex flex-col transform scale-95 transition-transform duration-150"
  >
    <!-- Search Bar -->
    <div class="p-3.5 border-b border-border-soft flex items-center gap-3">
      <svg class="h-5 w-5 text-ink-light fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.602 10.602Z" />
      </svg>
      <input
        type="text"
        id="cmd-palette-input"
        placeholder="Buscar promoción, barrio (Xuxán, Someso, Visma...), cooperativa o municipio..."
        class="w-full bg-transparent text-sm font-semibold text-ink placeholder-ink-light focus:outline-none"
        autocomplete="off"
      />
      <kbd class="px-2 py-0.5 rounded-md bg-canvas border border-border-soft text-[11px] font-mono font-bold text-ink-light hidden sm:inline-block">
        ESC
      </kbd>
    </div>

    <!-- Quick category shortcuts -->
    <div class="px-3.5 py-2 bg-canvas border-b border-border-soft flex items-center gap-1.5 overflow-x-auto no-scrollbar text-xs">
      <span class="text-[11px] font-bold text-ink-light uppercase mr-1">Ir a:</span>
      <a href={`${base}mapa`} class="px-2 py-0.5 rounded-md bg-surface border border-border-soft text-ink-muted hover:text-brand-green font-semibold">🗺️ Mapa</a>
      <a href={`${base}cooperativas`} class="px-2 py-0.5 rounded-md bg-surface border border-border-soft text-ink-muted hover:text-brand-green font-semibold">🟢 Cooperativas</a>
      <a href={`${base}gestoras`} class="px-2 py-0.5 rounded-md bg-surface border border-border-soft text-ink-muted hover:text-brand-green font-semibold">🏢 Gestoras</a>
    </div>

    <!-- Results list -->
    <div id="cmd-palette-results" class="max-h-[340px] overflow-y-auto divide-y divide-border-soft/60 p-1.5">
      <!-- Injected by JavaScript -->
    </div>

    <!-- Footer help -->
    <div class="p-2.5 bg-canvas border-t border-border-soft flex items-center justify-between text-[11px] font-medium text-ink-light">
      <div class="flex items-center gap-3">
        <span><kbd class="font-mono bg-surface px-1.5 py-0.5 rounded border border-border-soft">↑</kbd> <kbd class="font-mono bg-surface px-1.5 py-0.5 rounded border border-border-soft">↓</kbd> navegar</span>
        <span><kbd class="font-mono bg-surface px-1.5 py-0.5 rounded border border-border-soft">↵</kbd> abrir</span>
      </div>
      <span>{items.length} promociones disponibles</span>
    </div>
  </div>
</div>

<script define:vars={{ rawItems: items }}>
  const backdrop = document.getElementById('cmd-palette-backdrop');
  const modal = document.getElementById('cmd-palette-modal');
  const input = document.getElementById('cmd-palette-input');
  const resultsContainer = document.getElementById('cmd-palette-results');
  let selectedIndex = 0;
  let currentResults = [];
  let closeTimeout = null;

  function escapeHtml(str) {
    if (str == null) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function openPalette() {
    if (!backdrop || !modal || !input) return;
    if (closeTimeout) {
      clearTimeout(closeTimeout);
      closeTimeout = null;
    }
    backdrop.classList.remove('hidden');
    requestAnimationFrame(() => {
      backdrop.classList.remove('opacity-0');
      modal.classList.remove('scale-95');
      modal.classList.add('scale-100');
    });
    input.value = '';
    selectedIndex = 0;
    renderResults(rawItems.slice(0, 8));
    input.focus();
  }

  function closePalette() {
    if (!backdrop || !modal) return;
    if (closeTimeout) {
      clearTimeout(closeTimeout);
      closeTimeout = null;
    }
    backdrop.classList.add('opacity-0');
    modal.classList.remove('scale-100');
    modal.classList.add('scale-95');
    closeTimeout = setTimeout(() => {
      backdrop.classList.add('hidden');
      closeTimeout = null;
    }, 150);
  }

  // Expose global methods on window for layout and external triggers
  window.openCommandPalette = openPalette;
  window.closeCommandPalette = closePalette;

  function renderResults(list) {
    currentResults = list;
    if (!resultsContainer) return;
    if (list.length === 0) {
      resultsContainer.innerHTML = `
        <div class="py-8 text-center text-xs text-ink-light">
          No se encontraron promociones o ubicaciones con ese criterio.
        </div>
      `;
      return;
    }

    resultsContainer.innerHTML = list.map((item, idx) => {
      const isSelected = idx === selectedIndex;
      const isCoop = item.category === 'Cooperativa' || item.type === 'Cooperativa';
      const badgeClass = isCoop
        ? 'bg-brand-green-soft text-brand-green border-brand-green/20'
        : 'bg-brand-blue-soft text-brand-blue border-brand-blue/20';

      const safeUrl = escapeHtml(item.url || '#');
      const safeTitle = escapeHtml(item.title);
      const safeCategory = escapeHtml(item.category || item.type || 'Promoción');
      const safeLocation = [item.barrio, item.municipality || 'A Coruña'].filter(Boolean).map(escapeHtml).join(' · ');
      const safeStatus = item.status ? ` · ${escapeHtml(item.status)}` : '';
      const safePrice = item.precioMin != null
        ? `<span class="text-xs font-bold text-ink">${item.precioMin.toLocaleString('es-ES')} €</span>`
        : '<span class="text-[11px] text-ink-light">Consultar</span>';

      return `
        <a
          href="${safeUrl}"
          data-idx="${idx}"
          class="flex items-center justify-between p-2.5 rounded-xl transition-colors ${
            isSelected ? 'bg-surface border border-brand-green/40 shadow-sm' : 'hover:bg-canvas'
          }"
        >
          <div class="min-w-0 pr-3">
            <div class="flex items-center gap-2 mb-0.5">
              <span class="text-xs font-bold text-ink truncate">${safeTitle}</span>
              <span class="px-1.5 py-0.5 rounded-lg text-[10px] font-semibold border ${badgeClass}">
                ${safeCategory}
              </span>
            </div>
            <p class="text-[11px] text-ink-light truncate">
              📍 ${safeLocation}${safeStatus}
            </p>
          </div>
          <div class="text-right flex-shrink-0">
            ${safePrice}
          </div>
        </a>
      `;
    }).join('');
  }

  function handleFilter(query) {
    const q = query.toLowerCase().trim();
    if (!q) {
      renderResults(rawItems.slice(0, 8));
      return;
    }

    const filtered = rawItems.filter(item => {
      const title = (item.title || '').toLowerCase();
      const mun = (item.municipality || '').toLowerCase();
      const bar = (item.barrio || '').toLowerCase();
      const cat = (item.category || '').toLowerCase();
      return title.includes(q) || mun.includes(q) || bar.includes(q) || cat.includes(q);
    });

    selectedIndex = 0;
    renderResults(filtered.slice(0, 10));
  }

  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (backdrop?.classList.contains('hidden')) {
        openPalette();
      } else {
        closePalette();
      }
    } else if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
      e.preventDefault();
      openPalette();
    } else if (e.key === 'Escape' && !backdrop?.classList.contains('hidden')) {
      e.preventDefault();
      closePalette();
    } else if (!backdrop?.classList.contains('hidden')) {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = (selectedIndex + 1) % Math.max(1, currentResults.length);
        renderResults(currentResults);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = (selectedIndex - 1 + currentResults.length) % Math.max(1, currentResults.length);
        renderResults(currentResults);
      } else if (e.key === 'Enter' && currentResults[selectedIndex]) {
        e.preventDefault();
        window.location.href = currentResults[selectedIndex].url || '#';
      }
    }
  });

  input?.addEventListener('input', (e) => {
    handleFilter(e.target.value);
  });

  backdrop?.addEventListener('click', (e) => {
    if (e.target === backdrop) {
      closePalette();
    }
  });

  // Global trigger buttons (e.g. from header)
  document.querySelectorAll('[data-open-cmd-palette]').forEach(btn => {
    btn.addEventListener('click', () => openPalette());
  });
</script>
