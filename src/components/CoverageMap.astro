---
import { webBase } from '../lib/municipios.mjs';

export interface MapMarker {
  id: string;
  title: string;
  category?: string;
  type?: string | null;
  status?: string | null;
  precioMin?: number | null;
  habitacionesMin?: number | null;
  totalViviendas?: number | null;
  promotora?: string | null;
  municipality?: string | null;
  barrio?: string | null;
  lat: number;
  lng: number;
  url: string;
  color?: string;
  kind?: 'opportunity' | 'promotion' | 'cooperative';
}

export interface Props {
  markers?: MapMarker[];
  heightClass?: string;
  showFilters?: boolean;
  mapId?: string;
}

const {
  markers = [],
  heightClass = 'h-[360px] md:h-[480px]',
  showFilters = false,
  mapId = 'coverage-map',
} = Astro.props;

const base = webBase(import.meta.env.BASE_URL);
---

<div class="relative w-full overflow-hidden rounded-2xl border border-border-soft bg-surface shadow-premium flex flex-col">
  <!-- Top Map Bar: Category Filter Chips & Quick Municipality Zoom -->
  <div class="p-3.5 bg-surface border-b border-border-soft flex flex-col gap-2.5 z-20">
    <div class="flex flex-wrap items-center justify-between gap-2.5">
      <!-- Category Filter Chips -->
      <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5" role="group" aria-label="Filtros del mapa">
        <button
          type="button"
          class="map-filter-btn px-3 py-1.5 rounded-lg text-xs font-bold bg-brand-green text-surface transition-all cursor-pointer shadow-sm"
          data-map-filter="all"
        >
          Todos ({markers.length})
        </button>
        <button
          type="button"
          class="map-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-ink-muted bg-canvas border border-border-soft hover:border-border-medium hover:text-ink transition-all cursor-pointer"
          data-map-filter="coop"
        >
          🟢 Cooperativas
        </button>
        <button
          type="button"
          class="map-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-ink-muted bg-canvas border border-border-soft hover:border-border-medium hover:text-ink transition-all cursor-pointer"
          data-map-filter="obra-nueva"
        >
          🔵 Obra Nueva
        </button>
        <button
          type="button"
          class="map-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-ink-muted bg-canvas border border-border-soft hover:border-border-medium hover:text-ink transition-all cursor-pointer"
          data-map-filter="vpp"
        >
          🔴 VPP Protegida
        </button>
      </div>

      <!-- Quick Municipality Shortcuts -->
      <div class="flex items-center gap-1 overflow-x-auto no-scrollbar py-0.5 ml-auto">
        <span class="text-[11px] font-bold text-ink-light uppercase tracking-wider mr-1 hidden sm:inline">Zona:</span>
        <button type="button" class="muni-zoom-btn px-2 py-1 rounded-md text-[11px] font-semibold bg-canvas border border-border-soft hover:border-brand-green hover:text-brand-green transition-all" data-zoom-muni="coruna">
          A Coruña
        </button>
        <button type="button" class="muni-zoom-btn px-2 py-1 rounded-md text-[11px] font-semibold bg-canvas border border-border-soft hover:border-brand-green hover:text-brand-green transition-all" data-zoom-muni="oleiros">
          Oleiros
        </button>
        <button type="button" class="muni-zoom-btn px-2 py-1 rounded-md text-[11px] font-semibold bg-canvas border border-border-soft hover:border-brand-green hover:text-brand-green transition-all" data-zoom-muni="culleredo">
          Culleredo
        </button>
        <button type="button" class="muni-zoom-btn px-2 py-1 rounded-md text-[11px] font-semibold bg-canvas border border-border-soft hover:border-brand-green hover:text-brand-green transition-all" data-zoom-muni="arteixo">
          Arteixo
        </button>
        <button type="button" class="muni-zoom-btn px-2 py-1 rounded-md text-[11px] font-semibold bg-canvas border border-border-soft hover:border-brand-green hover:text-brand-green transition-all" data-zoom-muni="reset" title="Ver todo el área metropolitana">
          🔄 Ver todo
        </button>
      </div>
    </div>
  </div>

  <!-- Map Container -->
  <div
    id={mapId}
    class={`w-full ${heightClass} bg-[#eef3f0] relative z-10 leaflet-map-instance`}
    data-geojson-url={`${base}coverage.geojson`}
    data-markers={JSON.stringify(markers)}
    aria-label="Mapa interactivo de promociones y cooperativas"
  >
    <!-- Loader overlay -->
    <div class="absolute inset-0 flex items-center justify-center bg-surface/75 backdrop-blur-sm z-20 pointer-events-none transition-opacity duration-300" id={`${mapId}-loader`}>
      <div class="flex items-center gap-2.5 px-4 py-2.5 rounded-xl bg-surface shadow-md border border-border-soft">
        <svg class="animate-spin h-4 w-4 text-brand-green" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span class="text-xs font-bold text-ink">Cargando promociones en el mapa...</span>
      </div>
    </div>
  </div>

  <!-- Legend Bottom Bar -->
  <div class="px-4 py-2 bg-canvas border-t border-border-soft flex flex-wrap items-center justify-between gap-3 text-[11px] font-semibold text-ink-muted">
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-[#1f4d36] shadow-sm"></span> Cooperativas</span>
      <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-[#0369a1] shadow-sm"></span> Obra Nueva</span>
      <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-[#be123c] shadow-sm"></span> VPP Protegida</span>
      <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-[#6d28d9] shadow-sm"></span> Suelo</span>
    </div>
    <span class="text-ink-light">💡 Haz clic en los puntos o en la lista para ubicar en el mapa</span>
  </div>
</div>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  interface MarkerData {
    id: string;
    title: string;
    category?: string;
    type?: string | null;
    status?: string | null;
    precioMin?: number | null;
    habitacionesMin?: number | null;
    totalViviendas?: number | null;
    promotora?: string | null;
    municipality?: string | null;
    barrio?: string | null;
    lat: number;
    lng: number;
    url: string;
    color?: string;
    kind?: string;
  }

  // Centroids for quick zoom
  const MUNI_BOUNDS: Record<string, [number, number, number]> = {
    coruna: [43.3550, -8.4100, 13],
    oleiros: [43.3400, -8.3200, 13],
    culleredo: [43.3000, -8.3750, 13],
    arteixo: [43.3050, -8.5100, 13],
  };

  // Find all map instances
  document.querySelectorAll<HTMLElement>('.leaflet-map-instance').forEach((container) => {
    const mapId = container.id;
    const loader = document.getElementById(`${mapId}-loader`);

    const map = L.map(container, {
      attributionControl: true,
      scrollWheelZoom: false,
      zoomControl: true,
    });

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>',
      maxZoom: 18,
    }).addTo(map);

    const markersData: MarkerData[] = JSON.parse(container.dataset.markers || '[]');
    const markerLayer = L.layerGroup().addTo(map);
    const markerMap = new Map<string, L.CircleMarker>();
    let allMarkersBounds: L.LatLngBounds | null = null;

    // Disperse duplicate/stacked coordinates slightly in a mini spiral so EVERY pin is distinct
    function disperseCoordinates(items: MarkerData[]): Array<MarkerData & { displayLat: number; displayLng: number }> {
      const coordGroups = new Map<string, number>();

      return items.map((item) => {
        const key = `${item.lat.toFixed(4)},${item.lng.toFixed(4)}`;
        const count = coordGroups.get(key) || 0;
        coordGroups.set(key, count + 1);

        if (count === 0) {
          return { ...item, displayLat: item.lat, displayLng: item.lng };
        }

        // Apply slight radial offset (~30-60 meters) for duplicate points
        const angle = (count * 1.25);
        const radius = 0.00075 * Math.sqrt(count); // ~50m offset
        const displayLat = item.lat + radius * Math.cos(angle);
        const displayLng = item.lng + (radius * 1.3) * Math.sin(angle);

        return { ...item, displayLat, displayLng };
      });
    }

    const dispersedMarkers = disperseCoordinates(markersData);

    // Build rich popup HTML
    function createPopupContent(item: MarkerData): string {
      const locationText = [item.barrio, item.municipality].filter(Boolean).join(' · ') || 'Área metropolitana';
      const priceHtml = item.precioMin
        ? `<div class="text-sm font-extrabold text-[#1f4d36] mb-1.5">Desde ${item.precioMin.toLocaleString('es-ES')} €</div>`
        : '';
      const specs = [
        item.habitacionesMin ? `🛏️ ${item.habitacionesMin} habs` : '',
        item.totalViviendas ? `🏢 ${item.totalViviendas} vivs` : '',
        item.promotora ? `🏗️ ${item.promotora}` : '',
      ].filter(Boolean).join(' · ');

      const statusBadge = item.status
        ? `<span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-[#eaf3ee] text-[#1f4d36] mb-1.5 border border-[#1f4d36]/15">${item.status}</span>`
        : '';

      return `
        <div class="p-3.5 max-w-[275px] font-sans">
          <div class="flex items-center justify-between gap-1 mb-1">
            <span class="text-[10px] font-bold uppercase tracking-wider text-[#6b7a6f] truncate">📍 ${locationText}</span>
          </div>
          ${statusBadge}
          <h4 class="text-xs font-bold text-[#161c19] leading-snug mb-1.5 line-clamp-2">${item.title}</h4>
          ${priceHtml}
          ${specs ? `<p class="text-[11px] text-[#536057] mb-3 leading-tight">${specs}</p>` : ''}
          <a href="${item.url}" class="inline-flex items-center justify-center w-full py-2 px-3 rounded-lg text-xs font-bold bg-[#1f4d36] text-white hover:bg-[#163827] transition-colors no-underline shadow-sm">
            Ver detalles →
          </a>
        </div>
      `;
    }

    // Render markers with colors and hover effects
    function renderPins(itemsToRender: typeof dispersedMarkers) {
      markerLayer.clearLayers();
      markerMap.clear();

      const createdMarkers: L.CircleMarker[] = [];

      itemsToRender.forEach((m) => {
        let color = '#0369a1'; // Obra Nueva
        if (m.type === 'Cooperativa' || m.kind === 'cooperative' || (m.category && m.category.includes('Cooperativa'))) {
          color = '#1f4d36'; // Green
        } else if (m.type === 'Vivienda protegida' || (m.category && m.category.includes('Protegida')) || (m.category && m.category.includes('VPP'))) {
          color = '#be123c'; // Rose
        } else if (m.type === 'Suelo' || (m.category && m.category.includes('Suelo'))) {
          color = '#6d28d9'; // Purple
        }

        const marker = L.circleMarker([m.displayLat, m.displayLng], {
          radius: 8,
          color: '#ffffff',
          fillColor: color,
          fillOpacity: 0.92,
          weight: 2,
        });

        // Hover animation
        marker.on('mouseover', () => {
          marker.setRadius(11);
          marker.setStyle({ weight: 3 });
          marker.bringToFront();
        });
        marker.on('mouseout', () => {
          marker.setRadius(8);
          marker.setStyle({ weight: 2 });
        });

        marker.on('click', () => {
          window.dispatchEvent(new CustomEvent('map:marker-selected', { detail: { id: m.id } }));
        });

        marker.bindPopup(createPopupContent(m), {
          className: 'custom-map-popup',
          maxWidth: 290,
        });

        const tooltipPrice = m.precioMin ? ` · ${m.precioMin.toLocaleString('es-ES')} €` : '';
        marker.bindTooltip(`<strong>${m.title}</strong><br><span style="font-size:11px;color:#536057">${m.barrio || m.municipality || 'A Coruña'}${tooltipPrice}</span>`, {
          direction: 'top',
          offset: [0, -8],
          className: 'custom-map-tooltip',
        });

        marker.addTo(markerLayer);
        createdMarkers.push(marker);
        markerMap.set(m.id, marker);
      });

      if (createdMarkers.length > 0) {
        allMarkersBounds = L.featureGroup(createdMarkers).getBounds();
      }
    }

    renderPins(dispersedMarkers);

    // Global listener to focus marker from external list cards
    window.addEventListener('map:focus-marker', (event: any) => {
      const { id } = event.detail || {};
      if (!id) return;
      const marker = markerMap.get(id);
      if (marker) {
        const latLng = marker.getLatLng();
        map.flyTo(latLng, Math.max(map.getZoom(), 15), { duration: 0.8 });
        marker.openPopup();
        marker.setRadius(13);
        setTimeout(() => marker.setRadius(8), 1200);

        // Scroll map into view if outside viewport
        const rect = container.getBoundingClientRect();
        if (rect.top < 0 || rect.bottom > window.innerHeight) {
          container.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    });

    // Fetch GeoJSON boundary
    fetch(container.dataset.geojsonUrl || '')
      .then((res) => res.json())
      .then((geoData) => {
        const boundaries = L.geoJSON(geoData, {
          style: {
            color: '#1f4d36',
            fillColor: '#2e7d4f',
            fillOpacity: 0.05,
            weight: 1.5,
            dashArray: '3, 4',
          },
          onEachFeature(feature, layer) {
            layer.bindTooltip(feature.properties.name, {
              sticky: true,
              direction: 'top',
            });
          },
        }).addTo(map);

        if (allMarkersBounds && allMarkersBounds.isValid()) {
          map.fitBounds(allMarkersBounds.pad(0.12));
        } else {
          map.fitBounds(boundaries.getBounds(), { padding: [20, 20] });
        }

        if (loader) {
          loader.classList.add('opacity-0');
          setTimeout(() => loader.remove(), 300);
        }
      })
      .catch(() => {
        if (loader) loader.remove();
        if (allMarkersBounds && allMarkersBounds.isValid()) {
          map.fitBounds(allMarkersBounds.pad(0.15));
        } else {
          map.setView([43.3623, -8.4115], 11);
        }
      });

    // Invalidate map size on window resize or custom events
    window.addEventListener('resize', () => map.invalidateSize());
    window.addEventListener('map:invalidate', () => {
      setTimeout(() => map.invalidateSize(), 50);
    });

    // Quick municipality zoom shortcuts
    const muniZoomButtons = container.parentElement?.querySelectorAll<HTMLButtonElement>('[data-zoom-muni]');
    muniZoomButtons?.forEach((btn) => {
      btn.addEventListener('click', () => {
        const muniKey = btn.getAttribute('data-zoom-muni');
        if (muniKey === 'reset' && allMarkersBounds && allMarkersBounds.isValid()) {
          map.flyToBounds(allMarkersBounds.pad(0.12), { duration: 1 });
        } else if (muniKey && MUNI_BOUNDS[muniKey]) {
          const [lat, lng, zoom] = MUNI_BOUNDS[muniKey];
          map.flyTo([lat, lng], zoom, { duration: 1 });
        }
      });
    });

    // Map filters buttons
    const filterButtons = container.parentElement?.querySelectorAll<HTMLButtonElement>('[data-map-filter]');
    filterButtons?.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => {
          b.classList.remove('bg-brand-green', 'text-surface', 'shadow-sm');
          b.classList.add('text-ink-muted', 'bg-canvas');
        });
        btn.classList.remove('text-ink-muted', 'bg-canvas');
        btn.classList.add('bg-brand-green', 'text-surface', 'shadow-sm');

        const filterVal = btn.getAttribute('data-map-filter');
        if (filterVal === 'all') {
          renderPins(dispersedMarkers);
        } else if (filterVal === 'coop') {
          renderPins(dispersedMarkers.filter((m) => m.type === 'Cooperativa' || m.kind === 'cooperative' || (m.category && m.category.includes('Cooperativa'))));
        } else if (filterVal === 'obra-nueva') {
          renderPins(dispersedMarkers.filter((m) => m.type === 'Promoción nueva' || m.type === 'Obra Nueva' || (m.category && m.category.includes('Obra Nueva'))));
        } else if (filterVal === 'vpp') {
          renderPins(dispersedMarkers.filter((m) => m.type === 'Vivienda protegida' || (m.category && m.category.includes('Protegida')) || (m.category && m.category.includes('VPP'))));
        }

        if (allMarkersBounds && allMarkersBounds.isValid()) {
          map.fitBounds(allMarkersBounds.pad(0.12));
        }
      });
    });
  });
</script>
