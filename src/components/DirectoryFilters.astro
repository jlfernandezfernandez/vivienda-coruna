---
import { MUNICIPALITIES } from '../lib/municipios.mjs';
const { filters, action } = Astro.props;
---
<form method="get" action={action} class="mb-6 rounded-2xl border border-border-soft bg-surface p-5 shadow-premium" aria-label="Buscar vivienda y entidades">
  <div class="grid gap-4 sm:grid-cols-3">
    <label class="text-xs font-semibold text-ink-muted">Nombre, barrio o gestora
      <input type="search" name="q" value={filters.q} maxlength="120" placeholder="Xuxán, Visma, nombre…" class="mt-2 w-full rounded-lg border border-border-soft bg-canvas p-2.5 text-sm text-ink" />
    </label>
    <label class="text-xs font-semibold text-ink-muted">Municipio del proyecto
      <select name="municipality" class="mt-2 w-full rounded-lg border border-border-soft bg-canvas p-2.5 text-sm text-ink">
        <option value="">Todos</option>
        {MUNICIPALITIES.map(name => <option value={name} selected={filters.municipality === name}>{name}</option>)}
      </select>
    </label>
    <label class="text-xs font-semibold text-ink-muted">Precio máximo de vivienda (€)
      <input type="number" name="maxPrice" min="1" step="1" value={filters.maxPrice ?? ''} placeholder="Sin límite" class="mt-2 w-full rounded-lg border border-border-soft bg-canvas p-2.5 text-sm text-ink" />
    </label>
  </div>
  <div class="mt-4 flex flex-wrap items-center gap-4 text-xs text-ink-muted">
    <label class="flex items-center gap-2"><input type="checkbox" name="recruiting" value="1" checked={filters.recruiting} class="accent-brand-green" /> Solo captación confirmada</label>
    <label class="flex items-center gap-2"><input type="checkbox" name="excludeClosed" value="1" checked={filters.excludeClosed} class="accent-brand-green" /> Excluir agotadas y entregadas</label>
    <button type="submit" class="rounded-lg bg-brand-green px-4 py-2.5 font-bold text-surface">Buscar</button>
    <a href={action} class="font-semibold text-brand-green hover:underline">Limpiar filtros</a>
  </div>
  <p class="mt-3 text-xs text-ink-light">Las promociones sin precio publicado siguen visibles para consultar. La aportación inicial no es el precio total de la vivienda.</p>
</form>
