---
export interface Props {
  id: string;
  title: string;
  url: string;
  source: string;
  sourceKind?: string;
  publishedAt: string | null;
  firstSeenAt: string;
  location: string;
  type: string;
  status: string | null;
  summary: string;
  precioMin?: number | null;
  precioMax?: number | null;
  habitacionesMin?: number | null;
  banosMin?: number | null;
  promotora?: string | null;
  totalViviendas?: number | null;
  garaje?: boolean | null;
  trastero?: boolean | null;
  terraza?: boolean | null;
  enriched?: boolean;
}

const {
  id,
  title,
  url,
  source,
  sourceKind = 'official',
  publishedAt,
  firstSeenAt,
  location,
  type,
  status,
  summary,
  precioMin = null,
  precioMax = null,
  habitacionesMin = null,
  banosMin = null,
  promotora = null,
  totalViviendas = null,
  garaje = null,
  trastero = null,
  terraza = null,
  enriched = false
} = Astro.props;

import { municipalitySlug, webBase } from '../../scripts/lib/municipios.mjs';
import { statusColors } from '../../scripts/lib/statuses.mjs';

const base = webBase(import.meta.env.BASE_URL);

// Link badge a /municipio/<slug> cuando la location mapea a un municipio monitorizado.
const muniSlug = municipalitySlug(location);
const isMarket = sourceKind === 'market-alert';
const sourceLabel = isMarket ? 'Prensa local' : source;
const sourceBadgeBg = isMarket ? 'bg-brand-orange-soft text-brand-orange border border-brand-orange/10' : 'bg-brand-green-soft text-brand-green border border-brand-green/10';
const date = new Date(publishedAt || firstSeenAt).toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'Europe/Madrid',
});
const firstSeenDate = new Date(firstSeenAt).toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'short',
  timeZone: 'Europe/Madrid',
});

const mapsQuery = encodeURIComponent(location + ' A Coruña España');
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;
---

<article
  class="opportunity-card group relative flex flex-col justify-between rounded-2xl border border-border-soft bg-surface p-5 shadow-premium transition-all duration-300 hover:shadow-hover hover:border-border-medium"
  data-location={location}
  data-source-kind={sourceKind}
  data-type={type}
  data-precio-min={precioMin || ''}
  data-habitaciones-min={habitacionesMin || ''}
  data-banos-min={banosMin || ''}
  data-garaje={garaje === true ? 'true' : ''}
  data-trastero={trastero === true ? 'true' : ''}
  data-terraza={terraza === true ? 'true' : ''}
  data-text={`${title} ${location} ${type} ${summary || ''} ${promotora || ''}`.toLowerCase()}
>
  <div>
    <div class="flex items-center justify-between gap-4 mb-3">
      <div class="flex items-center gap-1.5">
        <svg class="h-3.5 w-3.5 text-ink-muted/80 fill-none stroke-current stroke-[2]" viewBox="0 0 24 24" width="14" height="14">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
        </svg>
        {muniSlug ? (
          <a href={`${base}municipio/${muniSlug}`} class="relative z-20 text-xs font-bold tracking-wider text-ink-muted uppercase hover:text-brand-green transition-colors">{location}</a>
        ) : (
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="text-xs font-bold tracking-wider text-ink-muted uppercase hover:text-brand-green transition-colors relative z-20" title="Abrir en Google Maps">
            {location}
          </a>
        )}
      </div>
      <time class="text-xs font-medium text-ink-light" datetime={publishedAt || firstSeenAt}>
        {date}
      </time>
    </div>

    <!-- Title -->
    <h3 class="text-base font-bold leading-snug tracking-tight text-ink group-hover:text-brand-green transition-colors duration-200 mb-1 md:text-lg">
      <a href={`${base}oportunidad/${id}`} aria-label={title} class="focus:outline-none">
        <span class="absolute inset-0 rounded-2xl cursor-pointer" aria-hidden="true"></span>
        {title}
      </a>
    </h3>
    <p class="text-[11px] text-ink-light mb-2">Detectado el {firstSeenDate}</p>

    {(precioMin || promotora || habitacionesMin || banosMin || garaje || trastero || terraza) && (
      <div class="mb-3.5 relative z-10 pointer-events-none">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
          {precioMin && (
            <span class="text-base font-extrabold text-brand-green sm:text-lg">
              Desde {precioMin.toLocaleString('es-ES')} €
            </span>
          )}

          {(habitacionesMin || banosMin) && (
            <span class="text-xs font-semibold text-ink-muted flex items-center gap-1.5 bg-canvas/60 px-2 py-0.5 rounded border border-border-soft">
              {habitacionesMin && <span><span aria-hidden="true">🛏️</span> {habitacionesMin} {habitacionesMin === 1 ? 'hab' : 'habs'}</span>}
              {habitacionesMin && banosMin && <span class="text-ink-light/40">|</span>}
              {banosMin && <span><span aria-hidden="true">🛁</span> {banosMin} {banosMin === 1 ? 'baño' : 'baños'}</span>}
            </span>
          )}

          {totalViviendas && (
            <span class="text-xs font-medium text-ink-light">
              <span aria-hidden="true">🏢</span> {totalViviendas} vivs.
            </span>
          )}
        </div>

        <div class="flex flex-wrap items-center gap-y-1.5 gap-x-2.5 text-xs text-ink-muted">
          {promotora && (
            <span class="font-medium">
              Promueve: <span class="text-ink font-bold">{promotora}</span>
            </span>
          )}

          {(garaje || trastero || terraza) && (
            <span class="text-ink-light flex flex-wrap items-center gap-1.5">
              {promotora && <span class="text-ink-light/40">·</span>}
              {garaje && <span class="bg-canvas border border-border-soft/60 px-1.5 py-0.5 rounded text-[11px]"><span aria-hidden="true">🚗</span> Garaje</span>}
              {trastero && <span class="bg-canvas border border-border-soft/60 px-1.5 py-0.5 rounded text-[11px]"><span aria-hidden="true">📦</span> Trastero</span>}
              {terraza && <span class="bg-canvas border border-border-soft/60 px-1.5 py-0.5 rounded text-[11px]"><span aria-hidden="true">☀️</span> Terraza</span>}
            </span>
          )}
        </div>
      </div>
    )}

    {summary && summary.trim().length > 0 && summary !== title && (
      <p class="text-sm text-ink-muted line-clamp-2 mb-4 leading-relaxed relative z-10 pointer-events-none">
        {summary}
      </p>
    )}
  </div>

  <!-- Card Footer: Unified Badges & CTA -->
  <div class="relative z-10">
    <div class="flex flex-wrap items-center justify-between gap-3 mt-4 pt-3 border-t border-border-soft">
      <div class="flex flex-wrap gap-1.5">
        <!-- Housing Type Badge -->
        <span class="inline-flex items-center rounded-lg bg-canvas border border-border-soft px-2.5 py-0.5 text-[11px] font-semibold text-ink-muted">
          {type}
        </span>

        <!-- Status Badge -->
        {status && (
          <span class={`inline-flex items-center rounded-lg px-2.5 py-0.5 text-[11px] font-semibold whitespace-nowrap ${statusColors(status)}`}>
            {status}
          </span>
        )}

        <!-- Source Badge -->
        <span class="inline-flex items-center rounded-lg px-2.5 py-0.5 text-[11px] font-semibold" class:list={[sourceBadgeBg]}>
          {sourceLabel}
        </span>
      </div>

      <!-- External Source Link -->
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="relative z-10 inline-flex items-center gap-1 text-xs font-bold text-brand-green hover:underline"
      >
        <span>Fuente original</span>
        <svg class="h-4.5 w-4.5 stroke-current stroke-2 fill-none" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
        </svg>
      </a>
    </div>

    {enriched && (
      <p class="mt-2 text-[11px] text-ink-light">Datos extraídos por IA · verifica en la fuente</p>
    )}
  </div>
</article>
