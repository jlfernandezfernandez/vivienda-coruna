---
export interface Props {
  id: string;
  title: string;
  url: string;
  source: string;
  sourceKind?: string;
  publishedAt: string | null;
  firstSeenAt: string;
  location: string;
  municipality?: string | null;
  barrio?: string | null;
  type: string;
  status: string | null;
  summary: string;
  precioMin?: number | null;
  precioMax?: number | null;
  habitacionesMin?: number | null;
  banosMin?: number | null;
  promotora?: string | null;
  totalViviendas?: number | null;
  garaje?: boolean | null;
  trastero?: boolean | null;
  terraza?: boolean | null;
  piscina?: boolean | null;
  ascensor?: boolean | null;
  entregaEstimada?: string | null;
  enriched?: boolean;
}

const {
  id,
  title,
  url,
  source,
  sourceKind = 'official',
  publishedAt,
  firstSeenAt,
  location,
  municipality = null,
  barrio = null,
  type,
  status,
  summary,
  precioMin = null,
  precioMax = null,
  habitacionesMin = null,
  banosMin = null,
  promotora = null,
  totalViviendas = null,
  garaje = null,
  trastero = null,
  terraza = null,
  piscina = null,
  ascensor = null,
  entregaEstimada = null,
  enriched = false,
} = Astro.props;

import { municipalitySlug, webBase } from '../lib/municipios.mjs';
import { statusColors } from '../lib/statuses.mjs';

const base = webBase(import.meta.env.BASE_URL);

// Municipality resolution for links
const displayMuni = municipality || location;
const muniSlug = municipalitySlug(displayMuni);
const isMarket = sourceKind === 'market-alert';
const normalizedSource = String(source || '').trim();
const sourceLabel = isMarket
  ? 'Prensa local'
  : /^firecrawl(?:\s*[·-]\s*)?$/i.test(normalizedSource)
    ? 'Web pública'
    : normalizedSource.replace(/^firecrawl\s*[·-]\s*/i, '') || 'Fuente pública';
const sourceBadgeBg = isMarket
  ? 'bg-brand-orange-soft text-brand-orange border border-brand-orange/15'
  : 'bg-brand-green-soft text-brand-green border border-brand-green/15';

const date = new Date(publishedAt || firstSeenAt).toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'Europe/Madrid',
});
---

<article
  class="opportunity-card group relative flex flex-col justify-between rounded-2xl border border-border-soft bg-surface p-4 shadow-premium transition-all duration-200 hover:shadow-hover hover:border-border-medium"
  data-location={displayMuni}
  data-barrio={barrio || ''}
  data-source-kind={sourceKind}
  data-type={type}
  data-precio-min={precioMin || ''}
  data-habitaciones-min={habitacionesMin || ''}
  data-banos-min={banosMin || ''}
  data-garaje={garaje === true ? 'true' : ''}
  data-trastero={trastero === true ? 'true' : ''}
  data-terraza={terraza === true ? 'true' : ''}
  data-piscina={piscina === true ? 'true' : ''}
  data-ascensor={ascensor === true ? 'true' : ''}
  data-text={`${title} ${displayMuni} ${barrio || ''} ${type} ${summary || ''} ${promotora || ''}`.toLowerCase()}
>
  <div>
    <!-- Top Meta Row -->
    <div class="flex items-center justify-between gap-3 mb-2.5">
      <div class="flex items-center gap-1.5 flex-wrap">
        <svg class="h-3.5 w-3.5 text-ink-light fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true" width="14" height="14">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
        </svg>

        {barrio && (
          <span class="text-xs font-extrabold text-ink tracking-wide">
            {barrio} ·
          </span>
        )}

        {muniSlug ? (
          <a href={`${base}municipio/${muniSlug}`} class="relative z-20 text-xs font-bold tracking-wider text-ink-muted uppercase hover:text-brand-green transition-colors">
            {displayMuni}
          </a>
        ) : (
          <span class="text-xs font-bold tracking-wider text-ink-muted uppercase">
            {displayMuni}
          </span>
        )}
      </div>

      <time class="text-xs font-medium text-ink-light whitespace-nowrap" datetime={publishedAt || firstSeenAt}>
        {date}
      </time>
    </div>

    <!-- Title -->
    <h3 class="text-base font-bold leading-snug tracking-tight text-ink group-hover:text-brand-green transition-colors duration-200 mb-2 md:text-lg">
      <a href={`${base}oportunidad/${id}`} aria-label={title} class="focus:outline-none">
        <span class="absolute inset-0 rounded-2xl cursor-pointer" aria-hidden="true"></span>
        {title}
      </a>
    </h3>

    <!-- Spec Highlight Block -->
    {(precioMin || promotora || habitacionesMin || banosMin || garaje || trastero || terraza || piscina || ascensor || entregaEstimada || totalViviendas) && (
      <div class="mb-3.5 relative z-10 pointer-events-none flex flex-col gap-2">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          {precioMin && (
            <span class="text-base sm:text-lg font-extrabold text-brand-green">
              Desde {precioMin.toLocaleString('es-ES')} €
            </span>
          )}

          {(habitacionesMin || banosMin) && (
            <span class="text-xs font-semibold text-ink-muted flex items-center gap-1.5 bg-canvas px-2.5 py-0.5 rounded-lg border border-border-soft">
              {habitacionesMin && <span>🛏️ {habitacionesMin} {habitacionesMin === 1 ? 'hab' : 'habs'}</span>}
              {habitacionesMin && banosMin && <span class="text-ink-light/40">|</span>}
              {banosMin && <span>🛁 {banosMin} {banosMin === 1 ? 'baño' : 'baños'}</span>}
            </span>
          )}

          {totalViviendas && (
            <span class="text-xs font-semibold text-ink-muted bg-canvas px-2 py-0.5 rounded-lg border border-border-soft">
              🏢 {totalViviendas} vivs.
            </span>
          )}

          {entregaEstimada && (
            <span class="text-xs font-semibold text-brand-blue bg-brand-blue-soft px-2 py-0.5 rounded-lg border border-brand-blue/15">
              📅 Entrega: {entregaEstimada}
            </span>
          )}
        </div>

        <div class="flex flex-wrap items-center gap-y-1 gap-x-2 text-xs text-ink-muted">
          {promotora && (
            <span class="font-medium">
              Promueve: <strong class="text-ink font-bold">{promotora}</strong>
            </span>
          )}

          {(garaje || trastero || terraza || piscina || ascensor) && (
            <div class="flex flex-wrap items-center gap-1.5 text-[11px] text-ink-light">
              {promotora && <span class="text-border-strong">·</span>}
              {garaje && <span title="Garaje disponible">🚗 Garaje</span>}
              {trastero && <span title="Trastero disponible">📦 Trastero</span>}
              {terraza && <span title="Terraza disponible">☀️ Terraza</span>}
              {piscina && <span title="Piscina disponible">🏊 Piscina</span>}
              {ascensor && <span title="Ascensor disponible">🛗 Ascensor</span>}
            </div>
          )}
        </div>
      </div>
    )}

    {summary && summary.trim().length > 0 && summary !== title && (
      <p class="text-sm text-ink-muted line-clamp-2 mb-3.5 leading-relaxed relative z-10 pointer-events-none">
        {summary}
      </p>
    )}
  </div>

  <!-- Card Footer: Unified Badges & CTA -->
  <div class="relative z-10">
    <div class="flex items-center justify-between gap-2 mt-3 pt-3 border-t border-border-soft">
      <div class="flex flex-wrap gap-1.5 items-center min-w-0">
        <!-- Status / Type Badge -->
        {status ? (
          <span class={`inline-flex items-center rounded-lg px-2.5 py-0.5 text-[11px] font-semibold whitespace-nowrap ${statusColors(status)}`}>
            {status}
          </span>
        ) : (
          <span class="inline-flex items-center rounded-lg bg-canvas border border-border-soft px-2.5 py-0.5 text-[11px] font-semibold text-ink-muted">
            {type}
          </span>
        )}

        <!-- Source Badge -->
        <span class={`inline-flex items-center rounded-lg px-2 py-0.5 text-[10px] font-semibold ${sourceBadgeBg}`}>
          {sourceLabel}
        </span>
      </div>

      <div class="flex items-center gap-2 flex-shrink-0">
        <!-- Locate on Map Button -->
        <button
          type="button"
          class="locate-on-map-btn relative z-20 inline-flex items-center gap-1 text-xs font-semibold text-ink-muted hover:text-brand-green hover:bg-brand-green-soft px-2 py-1 rounded-lg transition-colors cursor-pointer"
          data-locate-id={id}
          title="Ver este proyecto en el mapa"
        >
          <svg class="h-3.5 w-3.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true" width="14" height="14">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
          </svg>
          <span class="hidden sm:inline">Mapa</span>
        </button>

        <!-- External Source Link -->
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="relative z-20 inline-flex items-center gap-1 text-xs font-semibold text-ink-muted hover:text-brand-green px-1.5 py-1 rounded-lg transition-colors"
          title="Abrir fuente original en nueva pestaña"
        >
          <span>Fuente</span>
          <svg class="h-3.5 w-3.5 stroke-current stroke-2 fill-none" viewBox="0 0 24 24" aria-hidden="true" width="14" height="14">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
          </svg>
        </a>
      </div>
    </div>

    {enriched && (
      <p class="mt-1.5 text-[10px] text-ink-light">Datos extraídos con IA · verifica en la fuente original</p>
    )}
  </div>
</article>
