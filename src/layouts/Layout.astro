---
export interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown>;
}
import { siteBase } from '../lib/ui.mjs';

const { title, description, jsonLd } = Astro.props;
const base = siteBase(import.meta.env.BASE_URL);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

// Sección activa a partir de la ruta (quitando el base path del despliegue).
const rawPath = Astro.url.pathname;
const relPath = rawPath.startsWith(base) ? `/${rawPath.slice(base.length)}` : rawPath;
const activeSection = relPath.split('/')[1];
const sections = [
  { href: base, label: 'Novedades', id: '' },
  { href: `${base}cooperativas`, label: 'Cooperativas', id: 'cooperativas' },
  { href: `${base}gestoras`, label: 'Gestoras', id: 'gestoras' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fafaf7" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Twitter -->
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
    
    <!-- Favicon declarations to ensure browser compatibility -->
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    
    <!-- Google Fonts Preconnect and Import -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-canvas text-ink selection:bg-brand-green-soft selection:text-brand-green">
    <!-- Header: Sticky header, compact -->
    <header class="w-full border-b border-border-soft bg-surface/95 backdrop-blur-md sticky top-0 z-[1001] py-2.5" role="banner" aria-label="Cabecera del sitio">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 sm:px-6">
        <a class="group flex items-center gap-2 no-underline" href={base}>
          <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-brand-green text-surface transition-transform group-hover:scale-105 duration-200 shadow-sm">
            <svg class="h-4 w-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true" width="16" height="16">
              <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
            </svg>
          </div>
          <span class="text-base font-extrabold tracking-tight text-ink group-hover:text-brand-green transition-colors duration-200">Vivienda Coruña</span>
        </a>

        <a
          href="https://github.com/jlfernandezfernandez/vivienda-coruna"
          target="_blank"
          rel="noopener noreferrer"
          class="text-ink-muted hover:text-brand-green transition-colors duration-200"
          aria-label="Código fuente en GitHub"
        >
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" width="16" height="16">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
          </svg>
        </a>
      </div>
    </header>
    
    <main class="py-4 sm:py-6">
      <!-- Section navigation (compartida por todas las páginas) -->
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <nav class="mb-8 flex flex-wrap gap-2" aria-label="Secciones">
          {sections.map((section) =>
            section.id === activeSection ? (
              <a
                href={section.href}
                aria-current="page"
                class="rounded-full bg-brand-green px-4 py-2 text-sm font-bold text-surface shadow-sm"
              >
                {section.label}
              </a>
            ) : (
              <a
                href={section.href}
                class="rounded-full border border-border-soft bg-surface px-4 py-2 text-sm font-semibold text-ink-muted hover:text-ink hover:border-border-medium transition-colors"
              >
                {section.label}
              </a>
            )
          )}
        </nav>
      </div>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="w-full border-t border-border-soft bg-surface mt-16 py-8" role="contentinfo">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-ink-light">
        <p>
          Datos del Rexistro de Cooperativas da Xunta de Galicia, IGVS y prensa local ·
          actualización automática.
        </p>
        <div class="flex items-center gap-4">
          <a href="https://github.com/jlfernandezfernandez/vivienda-coruna" target="_blank" rel="noopener noreferrer" class="hover:text-brand-green transition-colors font-semibold">
            Código abierto
          </a>
          <span aria-hidden="true">·</span>
          <span>Área metropolitana de A Coruña</span>
        </div>
      </div>
    </footer>
  </body>
</html>
