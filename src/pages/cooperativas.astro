---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import { api } from '../lib/api/client.mjs';
import { applyApiFailure } from '../lib/api/boundary.mjs';
import { siteBase } from '../lib/ui.mjs';

let cooperatives = [];
let dashboard = { opportunities: [], gestoras: [] };
try {
  [cooperatives, dashboard] = await Promise.all([api.cooperatives(), api.dashboard()]);
} catch (error) {
  applyApiFailure(Astro.response, error);
}
const { opportunities, gestoras } = dashboard;
const coopOpportunities = opportunities.filter((o) => o.type === 'Cooperativa');
const base = siteBase(import.meta.env.BASE_URL);

const captacion = gestoras.flatMap((g) =>
  g.promotions
    .filter((p) => p.buscaSocios === true)
    .map((p) => ({ gestora: g, promo: p }))
);

const formatDate = (d: string | null) =>
  d
    ? new Date(`${d}T00:00:00`).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Madrid' })
    : null;

const pageTitle = 'Cooperativas de vivienda en A Coruña — registro oficial y captación | Vivienda Coruña';
const pageDescription = 'Cooperativas de vivienda constituidas en el área de A Coruña según el Rexistro de Cooperativas da Xunta, más señales en prensa y promociones en captación de socios.';
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Header -->
    <div class="mb-8 border-b border-border-soft pb-6">
      <h1 class="text-3xl font-extrabold tracking-tight text-ink md:text-4xl leading-tight">
        Cooperativas de vivienda en A Coruña
      </h1>
      <p class="text-sm md:text-base text-ink-muted mt-3 leading-relaxed max-w-2xl">
        Datos del Rexistro de Cooperativas da Xunta de Galicia combinados con monitorización diaria de prensa y fuentes oficiales.
      </p>
    </div>

    <!-- Stats row -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
      <div class="border border-border-soft bg-surface p-5 rounded-2xl shadow-premium">
        <span class="text-3xl font-extrabold text-brand-green">{cooperatives.length}</span>
        <p class="text-xs font-bold text-ink-muted uppercase tracking-wider mt-1">Cooperativas en el Rexistro</p>
      </div>
      <div class="border border-border-soft bg-surface p-5 rounded-2xl shadow-premium">
        <span class="text-3xl font-extrabold text-brand-green">{coopOpportunities.length}</span>
        <p class="text-xs font-bold text-ink-muted uppercase tracking-wider mt-1">Señales en prensa y fuentes</p>
      </div>
      <div class="border border-border-soft bg-surface p-5 rounded-2xl shadow-premium">
        <span class="text-3xl font-extrabold text-brand-green">{captacion.length}</span>
        <p class="text-xs font-bold text-ink-muted uppercase tracking-wider mt-1">Promociones en captación</p>
      </div>
    </div>

    <!-- Registry cooperatives -->
    <section class="mb-12" aria-labelledby="registro-title">
      <h2 id="registro-title" class="text-lg font-bold text-ink mb-4 flex items-center gap-2">
        Cooperativas constituidas
        <span class="inline-flex items-center justify-center px-2.5 py-0.5 rounded-lg bg-brand-green-soft text-brand-green border border-brand-green/10 text-[11px] font-semibold">
          Rexistro oficial
        </span>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {cooperatives.map((c) => (
          <div class="border border-border-soft bg-surface p-5 rounded-2xl shadow-premium">
            <div class="flex items-start justify-between gap-3 mb-2">
              <h3 class="text-sm font-bold text-ink capitalize leading-snug">{c.name.toLowerCase()}</h3>
              <span class="inline-flex items-center rounded-lg bg-canvas border border-border-soft px-2.5 py-0.5 text-[11px] font-semibold text-ink-muted flex-shrink-0">
                {c.municipality}
              </span>
            </div>
            <div class="text-xs text-ink-muted space-y-1">
              {formatDate(c.foundedAt) && (
                <p>Constituida el <strong class="text-ink">{formatDate(c.foundedAt)}</strong></p>
              )}
              {c.foundingPartners != null && (
                <p>{c.foundingPartners} socios fundadores</p>
              )}
              {c.address && <p>📍 {c.address}{c.postalCode ? `, ${c.postalCode}` : ''}</p>}
              {(c.email || c.phone) && (
                <p class="flex flex-wrap gap-x-3 gap-y-1 pt-1">
                  {c.email && (
                    <a href={`mailto:${c.email}`} class="font-semibold text-brand-green hover:underline">✉️ {c.email}</a>
                  )}
                  {c.phone && (
                    <a href={`tel:${String(c.phone).replace(/\s+/g, '')}`} class="font-semibold text-brand-green hover:underline">📞 {c.phone}</a>
                  )}
                </p>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Press signals -->
    <section class="mb-12" aria-labelledby="prensa-title">
      <h2 id="prensa-title" class="text-lg font-bold text-ink mb-4">
        Señales de cooperativas en prensa y fuentes oficiales
      </h2>
      {coopOpportunities.length === 0 ? (
        <div class="p-8 text-center rounded-2xl border border-border-soft text-ink-muted bg-surface text-sm">
          Sin señales de cooperativas en las últimas comprobaciones.
        </div>
      ) : (
        <div class="border border-border-soft bg-surface rounded-2xl shadow-premium overflow-hidden">
          <ul class="divide-y divide-border-soft">
            {coopOpportunities.map((o) => (
              <li>
                <a href={`${base}oportunidad/${o.id}`} class="group flex items-center justify-between gap-3 px-5 py-3.5 hover:bg-surface-hover transition-colors">
                  <div class="min-w-0">
                    <span class="text-sm font-bold text-ink group-hover:text-brand-green transition-colors block truncate">{o.title}</span>
                    <span class="text-[11px] text-ink-light">
                      {o.location || 'Área de A Coruña'} · {o.sourceKind === 'market-alert'
                        ? 'Prensa local'
                        : o.sourceKind === 'firecrawl-search'
                          ? new URL(o.url).hostname.replace(/^www\./, '')
                          : o.source}
                    </span>
                  </div>
                  <span class="text-[11px] text-ink-light flex-shrink-0">
                    {new Date(o.publishedAt || o.firstSeenAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Europe/Madrid' })}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>

    <!-- Captación -->
    <section class="mb-4" aria-labelledby="captacion-title">
      <h2 id="captacion-title" class="text-lg font-bold text-ink mb-4">
        Promociones en captación
      </h2>
      {captacion.length === 0 ? (
        <div class="p-8 text-center rounded-2xl border border-border-soft text-ink-muted bg-surface text-sm">
          Ninguna promoción con captación abierta detectada todavía.
        </div>
      ) : (
        <div class="border border-border-soft bg-surface rounded-2xl shadow-premium overflow-hidden">
          <ul class="divide-y divide-border-soft">
            {captacion.map(({ gestora, promo }) => (
              <li>
                <a href={`${base}gestora/${gestora.id}`} class="group flex items-center justify-between gap-3 px-5 py-3.5 hover:bg-surface-hover transition-colors">
                  <div class="min-w-0">
                    <span class="text-sm font-bold text-ink group-hover:text-brand-green transition-colors block truncate">{promo.name}</span>
                    <span class="text-[11px] text-ink-light">{gestora.name} · 📍 {promo.location || '—'}</span>
                  </div>
                  <span class="inline-flex items-center rounded-full border bg-status-ok/10 text-brand-green border-status-ok/25 px-2.5 py-0.5 text-[11px] font-semibold flex-shrink-0">
                    Captación abierta
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  </div>
</Layout>
