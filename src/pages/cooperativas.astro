---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import { getDatabase, getAllOpportunities, getAllGestoras, getAllCooperatives } from '../../scripts/lib/db.mjs';
import { webBase } from '../../scripts/lib/municipios.mjs';

const db = getDatabase();
const cooperatives = getAllCooperatives(db);
const coopOpportunities = getAllOpportunities(db, 150).filter((o) => o.type === 'Cooperativa');
const gestoras = getAllGestoras(db);
const base = webBase(import.meta.env.BASE_URL);

const captacion = gestoras.flatMap((g) =>
  g.promotions
    .filter((p) => p.buscaSocios === true)
    .map((p) => ({ gestora: g, promo: p }))
);

const formatDate = (d: string | null) =>
  d
    ? new Date(`${d}T00:00:00`).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Madrid' })
    : null;

const pageTitle = 'Cooperativas de vivienda en A Coruña — Registro Oficial y Captación | Vivienda Coruña';
const pageDescription = 'Todas las cooperativas de vivienda constituidas en el área de A Coruña según el Rexistro Oficial de la Xunta de Galicia, proyectos en captación de socios y señales de prensa.';
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Header -->
    <div class="mb-8 border-b border-border-soft pb-6">
      <div class="inline-flex items-center gap-1.5 rounded-lg bg-brand-green-soft px-2.5 py-0.5 text-[11px] font-semibold text-brand-green border border-brand-green/10 mb-3">
        <span class="flex h-1.5 w-1.5 rounded-full bg-brand-green pulse-indicator-ok"></span>
        Rexistro Oficial de Cooperativas de Galicia
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-ink md:text-4xl leading-tight">
        Cooperativas de Vivienda en A Coruña
      </h1>
      <p class="text-sm md:text-base text-ink-muted mt-3 leading-relaxed max-w-2xl">
        Listado completo de cooperativas residenciales constituidas en el área metropolitana, complementado con promociones que buscan socios y señales de prensa en tiempo real.
      </p>
    </div>

    <!-- Stats row -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
      <div class="border border-border-soft bg-surface p-5 rounded-2xl shadow-premium">
        <span class="text-3xl font-extrabold text-brand-green">{cooperatives.length}</span>
        <p class="text-xs font-bold text-ink-muted uppercase tracking-wider mt-1">Cooperativas en el Rexistro</p>
      </div>
      <div class="border border-border-soft bg-surface p-5 rounded-2xl shadow-premium">
        <span class="text-3xl font-extrabold text-brand-blue">{coopOpportunities.length}</span>
        <p class="text-xs font-bold text-ink-muted uppercase tracking-wider mt-1">Señales detectadas</p>
      </div>
      <div class="border border-border-soft bg-surface p-5 rounded-2xl shadow-premium">
        <span class="text-3xl font-extrabold text-brand-orange">{captacion.length}</span>
        <p class="text-xs font-bold text-ink-muted uppercase tracking-wider mt-1">En captación abierta</p>
      </div>
    </div>

    <!-- Captación Abierta Section (Priority) -->
    {captacion.length > 0 && (
      <section class="mb-12" aria-labelledby="captacion-title">
        <h2 id="captacion-title" class="text-lg font-bold text-ink mb-4 flex items-center gap-2">
          <span>Promociones en captación de socios</span>
          <span class="inline-flex items-center justify-center px-2.5 py-0.5 rounded-lg bg-status-ok/10 text-brand-green border border-status-ok/25 text-[11px] font-semibold">
            {captacion.length} activas
          </span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {captacion.map(({ gestora, promo }) => (
            <div class="border border-border-soft bg-surface p-5 rounded-2xl shadow-premium flex flex-col justify-between hover:shadow-hover transition-all">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="text-xs font-bold text-ink-muted uppercase tracking-wider">📍 {promo.location || 'Área metropolitana'}</span>
                  <span class="inline-flex items-center rounded-lg bg-status-ok/10 text-brand-green border border-status-ok/25 px-2.5 py-0.5 text-[10px] font-bold">
                    Captación abierta
                  </span>
                </div>
                <h3 class="text-base font-bold text-ink mb-1">{promo.name}</h3>
                <p class="text-xs text-ink-muted mb-3">Gestora: <strong class="text-ink font-semibold">{gestora.name}</strong></p>
                {promo.details && <p class="text-xs text-ink-light mb-3">{promo.details}</p>}
                {(promo.entregaEstimada || promo.aportacionInicial) && (
                  <div class="flex flex-wrap gap-2 text-xs text-ink-muted mb-4 bg-canvas p-2.5 rounded-xl border border-border-soft">
                    {promo.entregaEstimada && <span>📅 Entrega: <strong class="text-ink">{promo.entregaEstimada}</strong></span>}
                    {promo.aportacionInicial && <span>💶 Aportación: <strong class="text-ink">{promo.aportacionInicial.toLocaleString('es-ES')} €</strong></span>}
                  </div>
                )}
              </div>
              <a
                href={`${base}gestora/${gestora.id}`}
                class="w-full bg-brand-green text-surface text-center font-bold py-2 px-3 rounded-xl text-xs hover:bg-brand-green-hover transition-colors"
              >
                Ver ficha de la gestora y contacto →
              </a>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Registry cooperatives -->
    <section class="mb-12" aria-labelledby="registro-title">
      <h2 id="registro-title" class="text-lg font-bold text-ink mb-4 flex items-center gap-2">
        Cooperativas constituidas
        <span class="inline-flex items-center justify-center px-2.5 py-0.5 rounded-lg bg-brand-green-soft text-brand-green border border-brand-green/10 text-[11px] font-semibold">
          {cooperatives.length} inscritas
        </span>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {cooperatives.map((c) => (
          <div class="border border-border-soft bg-surface p-5 rounded-2xl shadow-premium flex flex-col justify-between">
            <div>
              <div class="flex items-start justify-between gap-3 mb-2">
                <h3 class="text-sm font-bold text-ink capitalize leading-snug">{c.name.toLowerCase()}</h3>
                <span class="inline-flex items-center rounded-lg bg-canvas border border-border-soft px-2.5 py-0.5 text-[11px] font-semibold text-ink-muted flex-shrink-0">
                  {c.municipality}
                </span>
              </div>
              <div class="text-xs text-ink-muted space-y-1 mt-3">
                {formatDate(c.foundedAt) && (
                  <p>Constituida el <strong class="text-ink font-semibold">{formatDate(c.foundedAt)}</strong></p>
                )}
                {c.foundingPartners != null && (
                  <p>{c.foundingPartners} socios fundadores</p>
                )}
                {c.address && <p class="text-ink-light">📍 {c.address}{c.postalCode ? `, ${c.postalCode}` : ''}</p>}
                {(c.email || c.phone) && (
                  <div class="flex flex-wrap gap-x-3 gap-y-1 pt-2 border-t border-border-soft mt-2">
                    {c.email && (
                      <a href={`mailto:${c.email}`} class="font-semibold text-brand-green hover:underline">✉️ {c.email}</a>
                    )}
                    {c.phone && (
                      <a href={`tel:${String(c.phone).replace(/\s+/g, '')}`} class="font-semibold text-brand-green hover:underline">📞 {c.phone}</a>
                    )}
                  </div>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Press signals -->
    <section class="mb-8" aria-labelledby="prensa-title">
      <h2 id="prensa-title" class="text-lg font-bold text-ink mb-4">
        Señales de cooperativas en prensa y fuentes oficiales
      </h2>
      {coopOpportunities.length === 0 ? (
        <div class="p-8 text-center rounded-2xl border border-border-soft text-ink-muted bg-surface text-sm">
          Sin señales de cooperativas en las últimas comprobaciones.
        </div>
      ) : (
        <div class="border border-border-soft bg-surface rounded-2xl shadow-premium overflow-hidden">
          <ul class="divide-y divide-border-soft">
            {coopOpportunities.map((o) => (
              <li>
                <a href={`${base}oportunidad/${o.id}`} class="group flex items-center justify-between gap-3 px-5 py-3.5 hover:bg-surface-hover transition-colors">
                  <div class="min-w-0">
                    <span class="text-sm font-bold text-ink group-hover:text-brand-green transition-colors block truncate">{o.title}</span>
                    <span class="text-[11px] text-ink-light">
                      {o.barrio ? `${o.barrio}, ` : ''}{o.location || 'Área de A Coruña'} · {o.sourceKind === 'market-alert' ? 'Prensa local' : o.source}
                    </span>
                  </div>
                  <span class="text-[11px] text-ink-light flex-shrink-0">
                    {new Date(o.publishedAt || o.firstSeenAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Europe/Madrid' })}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  </div>
</Layout>
