---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import CoverageMap from '../components/CoverageMap.astro';
import OpportunityCard from '../components/OpportunityCard.astro';
import { api } from '../lib/api/client.mjs';
import { apiSafe } from '../lib/api/boundary.mjs';
import { siteBase } from '../lib/ui.mjs';

const base = siteBase(import.meta.env.BASE_URL);
const dashboard = await apiSafe(Astro.response, () => api.dashboard(), { opportunities: [], sources: [], gestoras: [], cooperatives: [], events: [], municipalities: [], coverage: { boundaries: [], markers: [] } });
const apiUnavailable = Astro.response.status >= 400;
const { opportunities: items, sources, gestoras, cooperatives, events, coverage } = dashboard;
const municipalities = dashboard.municipalities.map((municipality) => municipality.name);
const recentEvents = events.slice(0, 8);
const healthySources = sources.filter((source) => source.ok).length;
const allItems = [...items].sort((a, b) => new Date(b.publishedAt || b.firstSeenAt).getTime() - new Date(a.publishedAt || a.firstSeenAt).getTime());

// Group items by date
const groupedItems = allItems.reduce((acc, item) => {
  const itemDate = new Date(item.publishedAt || item.firstSeenAt);
  const dateKey = itemDate.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Madrid' });
  const capitalizedKey = dateKey.charAt(0).toUpperCase() + dateKey.slice(1);
  if (!acc[capitalizedKey]) acc[capitalizedKey] = [];
  acc[capitalizedKey].push(item);
  return acc;
}, {} as Record<string, typeof allItems>);

const groupedEntries = Object.entries(groupedItems);

const coopOpportunities = items.filter((i) => i.type === 'Cooperativa');
const coopPromotions = gestoras.flatMap((g) =>
  g.promotions
    .filter((p) => p.buscaSocios === true)
    .map((p) => ({ ...p, gestoraId: g.id, gestoraName: g.name }))
);
const activeCoopCount = coopOpportunities.length + coopPromotions.length;

import { site } from '../lib/site.mjs';
const { title: siteTitle, description: siteDescription, headerTitle, headerSubtitle } = site;

const checkedAt = items.length ? new Date(Math.max(...items.map(i => new Date(i.lastSeenAt).getTime()))) : null;
const checkedLabel = checkedAt
  ? checkedAt.toLocaleString('es-ES', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Madrid' })
  : 'Pendiente';

const shortDate = (d: string) =>
  new Date(d).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', timeZone: 'Europe/Madrid' });
const truncate = (s: string, n = 60) => (s && s.length > n ? s.slice(0, n - 1) + '…' : s);
const eventIcons: Record<string, { icon: string; className: string }> = {
  new: { icon: '✚', className: 'text-brand-green' },
  status: { icon: '⇄', className: 'text-brand-blue' },
  price: { icon: '€', className: 'text-brand-orange' },
};
---

<Layout title={siteTitle} description={siteDescription}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    {apiUnavailable && (
      <div role="alert" class="mb-6 rounded-2xl border border-status-error/30 bg-status-error/10 p-4 text-sm text-ink">
        <strong class="font-bold">Datos temporalmente no disponibles.</strong>
      </div>
    )}

    <!-- Compact status line -->
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3 border-b border-border-soft pb-4">
      <div class="flex items-center gap-2">
        <span class:list={['flex h-2 w-2 rounded-full', apiUnavailable ? 'bg-status-error' : 'bg-status-ok pulse-indicator-ok']}></span>
        <span class="text-sm font-semibold text-ink">
          {apiUnavailable ? 'No disponible' : allItems.length + ' oportunidades'}
        </span>
        <span class="text-xs text-ink-light">·</span>
        <span class="text-xs text-ink-muted">
          {apiUnavailable ? 'Reintenta en un minuto' : 'Actualizado ' + checkedLabel}
        </span>
      </div>
      <div class="flex items-center gap-3 text-xs text-ink-muted">
        <span>{cooperatives.length} cooperativas</span>
        <span class="text-ink-light">·</span>
        <span>{gestoras.length} gestoras</span>
        <span class="text-ink-light">·</span>
        <span>{healthySources}/{sources.length} fuentes</span>
      </div>
    </div>

    <!-- Cooperativas activas -->
    {activeCoopCount > 0 && (
      <section class="mb-8" aria-labelledby="coop-activas-title">
        <div class="flex items-center justify-between gap-3 mb-3">
          <h2 id="coop-activas-title" class="text-base font-bold text-ink flex items-center gap-2">
            Captación abierta
            <span class="inline-flex items-center justify-center px-2 py-0.5 rounded-lg bg-brand-green-soft text-brand-green border border-brand-green/10 text-[11px] font-semibold">
              {activeCoopCount}
            </span>
          </h2>
        </div>
        <div class="flex gap-3 overflow-x-auto pb-2 -mx-1 px-1">
          {coopOpportunities.map((op) => (
            <a
              href={base + 'oportunidad/' + op.id}
              class="flex min-w-[240px] max-w-[260px] flex-shrink-0 flex-col gap-1.5 rounded-xl border border-border-soft bg-surface p-3.5 shadow-premium hover:border-border-medium hover:shadow-hover transition-all"
            >
              <span class="text-[11px] font-bold uppercase tracking-wider text-ink-muted truncate">{op.location || 'Área'}</span>
              <h3 class="text-sm font-bold text-ink leading-snug line-clamp-2">{op.nombrePromocion || op.title}</h3>
              {op.precioMin && <span class="text-sm font-extrabold text-brand-green">Desde {op.precioMin.toLocaleString('es-ES')} €</span>}
              <span class="text-[11px] text-ink-light mt-auto">{shortDate(op.firstSeenAt)}</span>
            </a>
          ))}
          {coopPromotions.map((promo) => (
            <a
              href={base + 'gestora/' + promo.gestoraId}
              class="flex min-w-[240px] max-w-[260px] flex-shrink-0 flex-col gap-1.5 rounded-xl border border-border-soft bg-surface p-3.5 shadow-premium hover:border-border-medium hover:shadow-hover transition-all"
            >
              <span class="text-[11px] font-bold uppercase tracking-wider text-ink-muted truncate">{promo.location || 'Área'}</span>
              <h3 class="text-sm font-bold text-ink leading-snug line-clamp-2">{promo.name}</h3>
              <span class="text-xs text-ink-muted">{promo.gestoraName}</span>
              <span class="text-[11px] text-brand-green font-semibold mt-auto">Busca socios</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Layout Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-8">

      <!-- Left Column: Search + Feed -->
      <div class="flex flex-col gap-6">

        <!-- Search + Municipio filter -->
        <div class="flex flex-col sm:flex-row gap-3">
          <div class="relative flex items-center h-10 flex-1">
            <input
              type="text"
              id="search-input"
              aria-label="Buscar promociones"
              placeholder="Buscar promotora, calle, tipo..."
              class="form-control w-full pl-10 pr-4 h-full text-base sm:text-sm"
            />
            <svg class="absolute left-3.5 h-4 w-4 text-ink-light fill-none stroke-current stroke-2" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.602 10.602Z" />
            </svg>
          </div>
          <select
            id="filter-municipio"
            aria-label="Filtrar por municipio"
            class="form-control form-select h-10 px-3 text-base sm:text-sm font-semibold cursor-pointer sm:w-52"
          >
            <option value="all">Todos los municipios</option>
            {municipalities.map(loc => (
              <option value={loc}>{loc}</option>
            ))}
          </select>
        </div>

        <!-- Feed header -->
        <div class="flex items-center justify-between pb-1 px-1">
          <h2 class="text-base font-bold text-ink flex items-center gap-2">
            Novedades
            <span id="active-count" class="inline-flex items-center justify-center px-2 py-0.5 rounded-lg bg-brand-green-soft text-brand-green border border-brand-green/10 text-[11px] font-semibold">
              {allItems.length}
            </span>
          </h2>
          <span class="text-xs text-ink-muted">Más reciente primero</span>
        </div>

        <!-- Grouped Bulletin Feed -->
        {groupedEntries.length === 0 ? (
          <div class="p-10 text-center rounded-2xl border border-border-soft text-ink-muted bg-surface text-sm">
            Sin novedades en esta comprobación.
          </div>
        ) : (
          <div class="flex flex-col gap-7" id="opportunities-feed">
            {groupedEntries.map(([dateKey, itemsGroup]) => (
              <div class="date-group flex flex-col gap-3" data-date={dateKey}>
                <h3 class="text-sm font-bold text-ink-muted border-b border-border-soft pb-2">
                  {dateKey}
                </h3>
                <div class="grid grid-cols-1 gap-4">
                  {itemsGroup.map((item) => <OpportunityCard {...item} />)}
                </div>
              </div>
            ))}
          </div>
        )}

        <!-- Empty state -->
        <div id="empty-search-state" class="hidden p-10 text-center rounded-2xl border border-border-soft bg-surface">
          <h3 class="text-base font-bold text-ink">No hay resultados</h3>
          <p class="mt-1 text-sm text-ink-muted">Ajusta la búsqueda o el municipio.</p>
        </div>
      </div>

      <!-- Right Column: Sidebar -->
      <aside class="flex flex-col gap-6">

        <!-- Coverage Map -->
        <section class="border border-border-soft bg-surface p-4 rounded-2xl shadow-premium" aria-labelledby="coverage-title">
          <div class="flex items-center justify-between mb-3">
            <h2 id="coverage-title" class="text-sm font-bold text-ink">Área de cobertura</h2>
            <span class="inline-flex items-center rounded-lg bg-brand-green-soft px-2 py-0.5 text-[11px] font-semibold text-brand-green border border-brand-green/10">
              {municipalities.length} municipios
            </span>
          </div>
          <CoverageMap boundaries={coverage.boundaries} markers={coverage.markers.map((marker) => ({ ...marker, url: base + marker.url.replace(/^\//, '') }))} />
        </section>

        <!-- Recent Changes -->
        <section class="border border-border-soft bg-surface p-4 rounded-2xl shadow-premium" aria-labelledby="changes-title">
          <h2 id="changes-title" class="text-sm font-bold text-ink mb-3">Últimos cambios</h2>
          {recentEvents.length === 0 ? (
            <p class="text-xs text-ink-light italic">Sin cambios detectados.</p>
          ) : (
            <ul class="divide-y divide-border-soft">
              {recentEvents.map((ev) => {
                const meta = eventIcons[ev.kind] || eventIcons.new;
                return (
                  <li class="flex items-start gap-2.5 py-2 first:pt-0 last:pb-0">
                    <span class={'font-bold text-xs leading-5 flex-shrink-0 ' + meta.className} aria-hidden="true">{meta.icon}</span>
                    <div class="min-w-0">
                      <p class="text-xs font-semibold text-ink truncate" title={ev.label}>{truncate(ev.label || ev.entityId)}</p>
                      <p class="text-[11px] text-ink-light">
                        {ev.newValue && <span>{ev.newValue} · </span>}
                        {shortDate(ev.detectedAt)}
                      </p>
                    </div>
                  </li>
                );
              })}
            </ul>
          )}
        </section>

        <!-- Sources -->
        <section class="border border-border-soft bg-surface p-4 rounded-2xl shadow-premium" aria-labelledby="sources-title">
          <h2 id="sources-title" class="text-sm font-bold text-ink mb-3">Fuentes</h2>
          <ul class="divide-y divide-border-soft">
            {sources.map((source) => (
              <li class="flex items-center justify-between py-2 first:pt-0 last:pb-0">
                <div class="flex items-center gap-2.5 min-w-0">
                  <span class={'h-2 w-2 rounded-full flex-shrink-0 ' + (source.ok ? 'bg-status-ok' : 'bg-status-error')} aria-hidden="true"></span>
                  {source.kind === 'firecrawl-search' ? (
                    <span class="text-xs font-semibold text-ink truncate">{source.name}</span>
                  ) : (
                    <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-ink hover:text-brand-green hover:underline truncate">
                      {source.name}
                    </a>
                  )}
                </div>
                <span class="text-[11px] text-ink-light flex-shrink-0">{source.scanned || 0}</span>
              </li>
            ))}
          </ul>
        </section>

      </aside>
    </div>
  </div>
</Layout>

<!-- Client Filtering: search + municipio only -->
<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const locationSelect = document.getElementById('filter-municipio') as HTMLSelectElement;
  const dateGroups = document.querySelectorAll('.date-group') as NodeListOf<HTMLElement>;
  const activeCountEl = document.getElementById('active-count');
  const emptyStateEl = document.getElementById('empty-search-state');

  let searchVal = '';
  let activeLocation = 'all';

  function updateFilters() {
    let visibleCount = 0;

    dateGroups.forEach(group => {
      const cards = group.querySelectorAll('.opportunity-card') as NodeListOf<HTMLElement>;
      let groupHasMatches = false;

      cards.forEach(card => {
        const text = card.getAttribute('data-text') || '';
        const location = card.getAttribute('data-location') || '';

        const matchesSearch = text.includes(searchVal.toLowerCase());
        let matchesLocation = activeLocation === 'all' || location === activeLocation
          || (activeLocation === 'Oleiros' && (location.includes('Perillo') || location.includes('Santa Cruz')))
          || (activeLocation === 'Culleredo' && location.includes('O Burgo'));

        if (matchesSearch && matchesLocation) {
          card.style.display = 'flex';
          groupHasMatches = true;
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      group.style.display = groupHasMatches ? 'block' : 'none';
    });

    if (activeCountEl) activeCountEl.textContent = String(visibleCount);
    if (emptyStateEl) emptyStateEl.classList.toggle('hidden', visibleCount > 0);
  }

  searchInput?.addEventListener('input', (e) => {
    searchVal = (e.target as HTMLInputElement).value;
    updateFilters();
  });

  locationSelect?.addEventListener('change', (e) => {
    activeLocation = (e.target as HTMLSelectElement).value || 'all';
    updateFilters();
  });
</script>