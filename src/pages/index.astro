---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import CoverageMap from '../components/CoverageMap.astro';
import OpportunityCard from '../components/OpportunityCard.astro';
import MarketThermometer from '../components/MarketThermometer.astro';
import { MUNICIPALITIES } from '../lib/municipios.mjs';
import { api } from '../lib/api/client.mjs';
import { apiSafe } from '../lib/api/boundary.mjs';
import { siteBase } from '../lib/ui.mjs';

const base = siteBase(import.meta.env.BASE_URL);
const dashboard = await apiSafe(Astro.response, () => api.dashboard(), {
  opportunities: [],
  sources: [],
  gestoras: [],
  cooperatives: [],
  events: [],
  municipalities: [],
  coverage: { boundaries: [], markers: [] },
});

const { opportunities: items, sources, gestoras, cooperatives, events, coverage } = dashboard;
const recentEvents = events.slice(0, 12);
const healthySources = (sources || []).filter((source: any) => source.ok).length;
const mapMarkers = (coverage?.markers || []).map((marker: any) => ({
  ...marker,
  url: base + String(marker.url || '').replace(/^\//, '')
}));

const checkedAt = items.length ? new Date(Math.max(...items.map((i: any) => new Date(i.lastSeenAt || i.publishedAt || Date.now()).getTime()))) : null;
const checkedLabel = checkedAt
  ? checkedAt.toLocaleString('es-ES', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Madrid' })
  : 'Actualizado hoy';
const allItems = [...items].sort((a: any, b: any) => new Date(b.publishedAt || b.firstSeenAt).getTime() - new Date(a.publishedAt || a.firstSeenAt).getTime());

// Group items by date for an editorial feed
const groupedItems = allItems.reduce((acc, item) => {
  const itemDate = new Date(item.publishedAt || item.firstSeenAt);
  const dateKey = itemDate.toLocaleDateString('es-ES', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'Europe/Madrid'
  });
  const capitalizedKey = dateKey.charAt(0).toUpperCase() + dateKey.slice(1);
  if (!acc[capitalizedKey]) acc[capitalizedKey] = [];
  acc[capitalizedKey].push(item);
  return acc;
}, {} as Record<string, typeof allItems>);

const groupedEntries = Object.entries(groupedItems);

// Cooperativas activas: oportunidades tipo Cooperativa + promociones de gestoras que buscan socios
const coopOpportunities = (items || []).filter((i: any) => i.type === 'Cooperativa');
const coopPromotions = (gestoras || []).flatMap((g: any) =>
  (g.promotions || [])
    .filter((p: any) => p.buscaSocios === true)
    .map((p: any) => ({ ...p, gestoraId: g.id, gestoraName: g.name }))
);
const activeCoopCount = coopOpportunities.length + coopPromotions.length;

import { site } from '../lib/site.mjs';
const { title: siteTitle, description: siteDescription, headerTitle, headerSubtitle } = site;
const municipalities = MUNICIPALITIES;

const shortDate = (d: string) =>
  new Date(d).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', timeZone: 'Europe/Madrid' });
const truncate = (s: string, n = 60) => (s && s.length > n ? s.slice(0, n - 1) + '…' : s);
const eventIcons: Record<string, { icon: string; className: string }> = {
  new: { icon: '✚', className: 'text-brand-green' },
  status: { icon: '⇄', className: 'text-brand-blue' },
  price: { icon: '€', className: 'text-brand-orange' },
};
---

<Layout
  title={siteTitle}
  description={siteDescription}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Page Header and compact monitor status -->
    <div class="mb-8 md:mb-10 border-b border-border-soft pb-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-1.5 rounded-lg bg-brand-green-soft px-2.5 py-0.5 text-[11px] font-semibold text-brand-green border border-brand-green/10 mb-3">
          <span class="flex h-1.5 w-1.5 rounded-full bg-brand-green pulse-indicator-ok"></span>
          Seguimiento en directo
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight text-ink md:text-4xl leading-tight">
          {headerTitle}
        </h1>
        <p class="text-sm md:text-base text-ink-muted mt-3 leading-relaxed">
          {headerSubtitle}
        </p>
      </div>
      <p class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-muted">
        <span class="flex items-center gap-1.5 font-semibold text-ink"><span class="h-2 w-2 rounded-full bg-status-ok pulse-indicator-ok" aria-hidden="true"></span>Monitor activo</span>
        <span aria-hidden="true">·</span><span>{checkedLabel}</span>
        <span aria-hidden="true">·</span><span>{healthySources}/{sources.length} fuentes operativas</span>
      </p>
    </div>

    <!-- Cooperativas activas ahora -->
    <section class="mb-10" aria-labelledby="coop-activas-title">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <h2 id="coop-activas-title" class="text-lg font-bold text-ink flex items-center gap-2">
          Cooperativas con captación abierta
          <span class="inline-flex items-center justify-center px-2.5 py-0.5 rounded-lg bg-brand-green-soft text-brand-green border border-brand-green/10 text-[11px] font-semibold">
            {activeCoopCount}
          </span>
        </h2>
        <a href={`${base}cooperativas`} class="text-xs font-bold text-brand-green hover:underline">
          Ver todas las cooperativas ({cooperatives.length}) →
        </a>
      </div>

      {activeCoopCount === 0 ? (
        <div class="rounded-2xl border border-border-soft bg-surface p-5 text-sm text-ink-muted shadow-premium">
          El registro oficial recoge <strong class="text-ink font-semibold">{cooperatives.length}</strong> cooperativas en la zona.
          <a href={`${base}cooperativas`} class="font-bold text-brand-green hover:underline ml-1">Consultar el registro →</a>
        </div>
      ) : (
        <div class="flex gap-4 overflow-x-auto pb-2 -mx-1 px-1 no-scrollbar">
          {coopOpportunities.map((op: any) => (
            <a
              href={`${base}oportunidad/${op.id}`}
              class="flex min-w-[260px] max-w-[280px] flex-shrink-0 flex-col gap-2 rounded-2xl border border-border-soft bg-surface p-4 shadow-premium hover:border-border-medium hover:shadow-hover transition-all"
            >
              <div class="flex items-center justify-between gap-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-ink-muted truncate">{op.barrio || op.location || 'Área'}</span>
                <span class="inline-flex items-center rounded-lg bg-brand-green-soft px-2 py-0.5 text-[10px] font-semibold text-brand-green border border-brand-green/10 flex-shrink-0">
                  {op.status || 'Captación abierta'}
                </span>
              </div>
              <h3 class="text-sm font-bold text-ink leading-snug line-clamp-2">{op.nombrePromocion || op.title}</h3>
              <div class="flex flex-wrap items-baseline gap-x-3 text-xs text-ink-muted">
                {op.precioMin && (
                  <span class="text-sm font-extrabold text-brand-green">Desde {op.precioMin.toLocaleString('es-ES')} €</span>
                )}
                {op.totalViviendas && <span>{op.totalViviendas} vivs.</span>}
              </div>
              <span class="text-[11px] text-ink-light mt-auto">Detectado el {shortDate(op.firstSeenAt)}</span>
            </a>
          ))}
          {coopPromotions.map((promo: any) => (
            <a
              href={`${base}gestora/${promo.gestoraId}`}
              class="flex min-w-[260px] max-w-[280px] flex-shrink-0 flex-col gap-2 rounded-2xl border border-border-soft bg-surface p-4 shadow-premium hover:border-border-medium hover:shadow-hover transition-all"
            >
              <div class="flex items-center justify-between gap-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-ink-muted truncate">{promo.barrio || promo.location || 'Área'}</span>
                <span class="inline-flex items-center rounded-lg bg-brand-green-soft px-2 py-0.5 text-[10px] font-semibold text-brand-green border border-brand-green/10 flex-shrink-0">
                  {promo.status || 'Captación abierta'}
                </span>
              </div>
              <h3 class="text-sm font-bold text-ink leading-snug line-clamp-2">{promo.name}</h3>
              <span class="text-xs text-ink-muted">Gestiona: <strong class="text-ink">{promo.gestoraName}</strong></span>
              <span class="text-[11px] text-brand-green font-semibold mt-auto">Busca socios</span>
            </a>
          ))}
        </div>
      )}
    </section>


    <!-- Mobile View Switcher (Lista vs Mapa) -->
    <div class="lg:hidden mb-6 flex rounded-xl bg-canvas p-1 border border-border-soft max-w-sm mx-auto">
      <button
        type="button"
        id="btn-view-list"
        class="flex-1 text-center py-2 rounded-lg text-xs font-bold bg-brand-green text-surface transition-all cursor-pointer flex items-center justify-center gap-1.5"
      >
        <span>📋 Lista de Novedades</span>
      </button>
      <button
        type="button"
        id="btn-view-map"
        class="flex-1 text-center py-2 rounded-lg text-xs font-semibold text-ink-muted hover:bg-surface-hover transition-all cursor-pointer flex items-center justify-center gap-1.5"
      >
        <span>🗺️ Ver Mapa ({mapMarkers.length})</span>
      </button>
    </div>

    <!-- Layout Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

      <!-- Left Column: Search & Grouped Feed -->
      <div class="lg:col-span-2 flex flex-col gap-6" id="feed-container">

        <!-- Card 1: Búsqueda y Ubicación -->
        <div class="order-2 border border-border-soft bg-surface p-5 rounded-2xl shadow-premium flex flex-col gap-4">
          <!-- Text Search input -->
          <div class="relative flex items-center h-10 w-full">
            <input
              type="text"
              id="search-input"
              aria-label="Buscar promociones"
              placeholder="Buscar por barrio (Xuxán, Someso, Visma...), promotora, tipo..."
              class="w-full pl-10 pr-4 h-full rounded-xl border border-border-soft bg-canvas text-sm text-ink placeholder-ink-light focus:outline-none focus:border-brand-green focus:ring-2 focus:ring-brand-green/20 transition-all"
            />
            <svg class="absolute left-3.5 h-4 w-4 text-ink-light fill-none stroke-current stroke-2" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.602 10.602Z" />
            </svg>
          </div>

          <!-- Filter 1: Tipo de señal -->
          <div class="flex flex-col gap-2 pt-2 border-t border-border-soft">
            <span class="text-xs font-bold text-ink-muted uppercase tracking-wider">Tipo de señal</span>
            <div class="flex rounded-xl bg-canvas p-1 border border-border-soft h-10 items-center max-w-md">
              <button
                class="flex-1 text-center h-8 rounded-lg text-xs sm:text-sm font-semibold bg-brand-green text-surface transition-all cursor-pointer"
                data-filter-source="all"
                aria-pressed="true"
              >
                Todas
              </button>
              <button
                class="flex-1 text-center h-8 rounded-lg text-xs sm:text-sm font-semibold text-ink-muted hover:bg-surface-hover transition-all cursor-pointer"
                data-filter-source="official"
                aria-pressed="false"
              >
                Oficiales
              </button>
              <button
                class="flex-1 text-center h-8 rounded-lg text-xs sm:text-sm font-semibold text-ink-muted hover:bg-surface-hover transition-all cursor-pointer"
                data-filter-source="market-alert"
                aria-pressed="false"
              >
                Prensa
              </button>
            </div>
          </div>

          <!-- Filter 2: Categoría -->
          <div class="flex flex-col gap-2 pt-2 border-t border-border-soft">
            <span class="text-xs font-bold text-ink-muted uppercase tracking-wider">Categoría</span>
            <div class="flex flex-wrap gap-1.5 items-center">
              <button
                class="h-8 px-3 inline-flex items-center rounded-lg border text-xs sm:text-sm font-semibold bg-brand-green-soft text-brand-green border-brand-green/20 cursor-pointer transition-all"
                data-filter-category="all"
                aria-pressed="true"
              >
                Todas
              </button>
              <button
                class="h-8 px-3 inline-flex items-center rounded-lg border text-xs sm:text-sm font-semibold bg-surface text-ink-muted border-border-soft hover:border-border-medium hover:bg-surface-hover transition-all cursor-pointer"
                data-filter-category="Promoción nueva"
                aria-pressed="false"
              >
                Obra Nueva
              </button>
              <button
                class="h-8 px-3 inline-flex items-center rounded-lg border text-xs sm:text-sm font-semibold bg-surface text-ink-muted border-border-soft hover:border-border-medium hover:bg-surface-hover transition-all cursor-pointer"
                data-filter-category="Cooperativa"
                aria-pressed="false"
              >
                Cooperativas
              </button>
              <button
                class="h-8 px-3 inline-flex items-center rounded-lg border text-xs sm:text-sm font-semibold bg-surface text-ink-muted border-border-soft hover:border-border-medium hover:bg-surface-hover transition-all cursor-pointer"
                data-filter-category="Vivienda protegida"
                aria-pressed="false"
              >
                VPP / VPA Oficial
              </button>
              <button
                class="h-8 px-3 inline-flex items-center rounded-lg border text-xs sm:text-sm font-semibold bg-surface text-ink-muted border-border-soft hover:border-border-medium hover:bg-surface-hover transition-all cursor-pointer"
                data-filter-category="Suelo"
                aria-pressed="false"
              >
                Suelo
              </button>
            </div>
          </div>

          <!-- Filter 3: Municipio -->
          <div class="flex flex-col gap-2 pt-2 border-t border-border-soft">
            <span class="text-xs font-bold text-ink-muted uppercase tracking-wider">Municipio</span>
            <div class="flex flex-wrap gap-1.5 items-center">
              <button
                class="h-8 px-3 inline-flex items-center rounded-lg border text-xs sm:text-sm font-semibold bg-brand-green-soft text-brand-green border-brand-green/20 cursor-pointer transition-all"
                data-filter-location="all"
                aria-pressed="true"
              >
                Todos
              </button>
              {municipalities.map(loc => (
                <button
                  class="h-8 px-3 inline-flex items-center rounded-lg border text-xs sm:text-sm font-semibold bg-surface text-ink-muted border-border-soft hover:border-border-medium hover:bg-surface-hover transition-all cursor-pointer"
                  data-filter-location={loc}
                  aria-pressed="false"
                >
                  {loc}
                </button>
              ))}
            </div>
          </div>
        </div>

        <!-- Card 2: Filtros Avanzados (colapsable) -->
        <details class="order-3 border border-border-soft bg-surface p-5 rounded-2xl shadow-premium group">
          <summary class="text-xs font-bold text-ink-muted uppercase tracking-wider cursor-pointer list-none flex items-center justify-between">
            <span>Filtros avanzados (precio, habitaciones y equipamiento)</span>
            <svg class="h-4 w-4 text-ink-light transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/>
            </svg>
          </summary>

          <div class="flex flex-col gap-4 mt-4">
            <!-- Price + Bedrooms + Bathrooms row -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <!-- Price Slider -->
              <div class="flex flex-col gap-2">
                <div class="flex justify-between items-center">
                  <span class="text-xs font-bold text-ink-muted uppercase tracking-wider">Precio máximo</span>
                  <span id="price-display" class="inline-flex items-center rounded-lg bg-brand-green-soft px-2.5 py-0.5 text-[11px] font-semibold text-brand-green border border-brand-green/10">
                    Sin límite
                  </span>
                </div>
                <div class="flex items-center h-10">
                  <input 
                    type="range" 
                    id="price-range" 
                    min="150000" 
                    max="600000" 
                    step="25000" 
                    value="600000" 
                    class="w-full accent-brand-green cursor-pointer h-1.5 bg-canvas rounded-lg appearance-none border border-border-soft"
                  />
                </div>
              </div>

              <!-- Bedrooms Filter -->
              <div class="flex flex-col gap-2">
                <span class="text-xs font-bold text-ink-muted uppercase tracking-wider">Dormitorios</span>
                <div class="flex rounded-xl bg-canvas p-1 border border-border-soft h-10 items-center">
                  <button class="flex-1 text-center h-8 rounded-lg text-xs sm:text-sm font-semibold bg-brand-green text-surface transition-all cursor-pointer" data-filter-rooms="0">Todos</button>
                  <button class="flex-1 text-center h-8 rounded-lg text-xs sm:text-sm font-semibold text-ink-muted hover:bg-surface-hover transition-all cursor-pointer" data-filter-rooms="1">1+</button>
                  <button class="flex-1 text-center h-8 rounded-lg text-xs sm:text-sm font-semibold text-ink-muted hover:bg-surface-hover transition-all cursor-pointer" data-filter-rooms="2">2+</button>
                  <button class="flex-1 text-center h-8 rounded-lg text-xs sm:text-sm font-semibold text-ink-muted hover:bg-surface-hover transition-all cursor-pointer" data-filter-rooms="3">3+</button>
                </div>
              </div>

              <!-- Bathrooms Filter -->
              <div class="flex flex-col gap-2">
                <span class="text-xs font-bold text-ink-muted uppercase tracking-wider">Baños</span>
                <div class="flex rounded-xl bg-canvas p-1 border border-border-soft h-10 items-center">
                  <button class="flex-1 text-center h-8 rounded-lg text-xs sm:text-sm font-semibold bg-brand-green text-surface transition-all cursor-pointer" data-filter-baths="0">Todos</button>
                  <button class="flex-1 text-center h-8 rounded-lg text-xs sm:text-sm font-semibold text-ink-muted hover:bg-surface-hover transition-all cursor-pointer" data-filter-baths="1">1+</button>
                  <button class="flex-1 text-center h-8 rounded-lg text-xs sm:text-sm font-semibold text-ink-muted hover:bg-surface-hover transition-all cursor-pointer" data-filter-baths="2">2+</button>
                  <button class="flex-1 text-center h-8 rounded-lg text-xs sm:text-sm font-semibold text-ink-muted hover:bg-surface-hover transition-all cursor-pointer" data-filter-baths="3">3+</button>
                </div>
              </div>
            </div>

            <!-- Extras Checkboxes -->
            <div class="flex flex-col gap-2 pt-2 border-t border-border-soft">
              <span class="text-xs font-bold text-ink-muted uppercase tracking-wider">Equipamiento adicional</span>
              <div class="flex flex-wrap gap-4 items-center">
                <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-semibold text-ink-muted select-none">
                  <input type="checkbox" id="filter-garage" class="h-4 w-4 rounded border-border-soft accent-brand-green cursor-pointer" />
                  <span>🚗 Garaje</span>
                </label>
                <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-semibold text-ink-muted select-none">
                  <input type="checkbox" id="filter-storage" class="h-4 w-4 rounded border-border-soft accent-brand-green cursor-pointer" />
                  <span>📦 Trastero</span>
                </label>
                <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-semibold text-ink-muted select-none">
                  <input type="checkbox" id="filter-terrace" class="h-4 w-4 rounded border-border-soft accent-brand-green cursor-pointer" />
                  <span>☀️ Terraza</span>
                </label>
                <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-semibold text-ink-muted select-none">
                  <input type="checkbox" id="filter-pool" class="h-4 w-4 rounded border-border-soft accent-brand-green cursor-pointer" />
                  <span>🏊 Piscina</span>
                </label>
                <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-semibold text-ink-muted select-none">
                  <input type="checkbox" id="filter-elevator" class="h-4 w-4 rounded border-border-soft accent-brand-green cursor-pointer" />
                  <span>🛗 Ascensor</span>
                </label>
              </div>
            </div>
          </div>
        </details>

        <!-- Feed Header -->
        <div class="order-0 flex items-center justify-between pb-2 px-1 mt-2">
          <h2 class="text-lg font-bold text-ink flex items-center gap-2">
            Novedades detectadas
            <span
              id="active-count"
              class="inline-flex items-center justify-center px-2.5 py-0.5 rounded-lg bg-brand-green-soft text-brand-green border border-brand-green/10 text-[11px] font-semibold"
            >
              {allItems.length}
            </span>
          </h2>
          <span class="text-xs text-ink-muted">Publicación más reciente</span>
        </div>

        <!-- Grouped Bulletin Feed -->
        {groupedEntries.length === 0 ? (
          <div class="p-10 text-center rounded-2xl border border-border-soft text-ink-muted bg-surface text-sm">
            Sin novedades en esta comprobación.
          </div>
        ) : (
          <div class="order-1 flex flex-col gap-8" id="opportunities-feed">
            {groupedEntries.map(([dateKey, itemsGroup]: [string, any]) => (
              <div class="date-group flex flex-col gap-3" data-date={dateKey}>
                <h3 class="text-sm font-bold text-ink-muted border-b border-border-soft pb-2 mt-2">
                  {dateKey}
                </h3>
                <div class="grid grid-cols-1 gap-4">
                  {(itemsGroup as any[]).map((item: any) => <OpportunityCard {...item} />)}
                </div>
              </div>
            ))}
          </div>
        )}

        <!-- Search Empty State -->
        <div
          id="empty-search-state"
          class="order-1 hidden p-12 text-center rounded-2xl border border-border-soft bg-surface"
        >
          <svg class="mx-auto h-10 w-10 text-ink-light fill-none stroke-current stroke-2" viewBox="0 0 24 24" width="40" height="40">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
          </svg>
          <h3 class="mt-4 text-base font-bold text-ink">No hay resultados con estos filtros</h3>
          <p class="mt-1.5 text-sm text-ink-muted">Prueba a borrar o ajustar los términos de búsqueda.</p>
        </div>
      </div>

      <!-- Right Column: Sidebar (Sticky on desktop, toggleable on mobile) -->
      <aside class="flex flex-col gap-6" id="sidebar-container">

        <!-- Interactive Map Card -->
        <section class="border border-border-soft bg-surface p-5 rounded-2xl shadow-premium" aria-labelledby="coverage-title">
          <div class="flex items-center justify-between mb-4">
            <h2 id="coverage-title" class="text-base font-bold text-ink">Mapa Metropolitano</h2>
            <a href={`${base}mapa`} class="text-xs font-bold text-brand-green hover:underline">
              Ampliar mapa →
            </a>
          </div>
          <CoverageMap markers={mapMarkers} heightClass="h-[320px]" />
          <p class="text-xs text-ink-muted mt-3 leading-relaxed">
            {mapMarkers.length} promociones geolocalizadas en A Coruña y su corona metropolitana.
          </p>
        </section>

        <!-- Recent Changes Section -->
        <section class="border border-border-soft bg-surface p-5 rounded-2xl shadow-premium" aria-labelledby="changes-title">
          <h2 id="changes-title" class="text-base font-bold text-ink mb-4">Últimos cambios detectados</h2>
          {recentEvents.length === 0 ? (
            <p class="text-xs text-ink-light italic">Sin cambios detectados todavía.</p>
          ) : (
            <ul class="divide-y divide-border-soft">
              {(recentEvents || []).map((ev: any) => {
                const meta = eventIcons[ev.kind] || eventIcons.new;
                return (
                  <li class="flex items-start gap-2.5 py-2.5 first:pt-0 last:pb-0">
                    <span class={`font-bold text-xs leading-5 flex-shrink-0 ${meta.className}`} aria-hidden="true">{meta.icon}</span>
                    <div class="min-w-0">
                      <p class="text-xs font-semibold text-ink truncate" title={ev.label}>{truncate(ev.label || ev.entityId)}</p>
                      <p class="text-[11px] text-ink-light">
                        {ev.newValue && <span>{ev.newValue} · </span>}
                        {shortDate(ev.detectedAt)}
                      </p>
                    </div>
                  </li>
                );
              })}
            </ul>
          )}
        </section>

        <!-- Sources Log Section -->
        <section class="border border-border-soft bg-surface p-5 rounded-2xl shadow-premium" aria-labelledby="sources-title">
          <h2 id="sources-title" class="text-base font-bold text-ink mb-4">Fuentes de Datos</h2>
          <ul class="divide-y divide-border-soft">
            {(sources || []).map((source: any) => (
              <li class="flex items-center justify-between py-2.5 first:pt-0 last:pb-0">
                <div class="flex items-center gap-2.5 min-w-0">
                  <span
                    class={`h-2.5 w-2.5 rounded-full flex-shrink-0 ${source.ok ? 'bg-status-ok pulse-indicator-ok' : 'bg-status-error pulse-indicator-warning'}`}
                    aria-hidden="true"
                    title={source.ok ? 'Fuente operativa' : 'Problema de conexión'}
                  ></span>
                  <a
                    href={source.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-bold text-ink hover:text-brand-green hover:underline truncate"
                  >
                    {source.name}
                  </a>
                </div>
                <span class="inline-flex items-center rounded-lg bg-canvas border border-border-soft px-2.5 py-0.5 text-[11px] font-semibold text-ink-light flex-shrink-0">
                  {source.scanned || 0} reg
                </span>
              </li>
            ))}
          </ul>
        </section>

      </aside>
    </div>

    <!-- Secondary market context -->
    <section class="mt-10 border-t border-border-soft pt-8" aria-label="Contexto de mercado">
      <div class="mb-4 flex items-baseline justify-between gap-4">
        <h2 class="text-base font-bold text-ink">Contexto de mercado</h2>
        <span class="text-xs text-ink-light">{mapMarkers.length} ubicaciones geolocalizadas</span>
      </div>
      <MarketThermometer />
    </section>
  </div>
</Layout>

<!-- Client Filtering & View Switcher Javascript -->
<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const sourceFilters = document.querySelectorAll('[data-filter-source]');
  const categoryFilters = document.querySelectorAll('[data-filter-category]');
  const locationFilters = document.querySelectorAll('[data-filter-location]');
  const roomFilters = document.querySelectorAll('[data-filter-rooms]');
  const bathFilters = document.querySelectorAll('[data-filter-baths]');
  const priceRange = document.getElementById('price-range') as HTMLInputElement;
  const priceDisplay = document.getElementById('price-display');

  // Checkboxes
  const filterGarage = document.getElementById('filter-garage') as HTMLInputElement;
  const filterStorage = document.getElementById('filter-storage') as HTMLInputElement;
  const filterTerrace = document.getElementById('filter-terrace') as HTMLInputElement;
  const filterPool = document.getElementById('filter-pool') as HTMLInputElement;
  const filterElevator = document.getElementById('filter-elevator') as HTMLInputElement;

  // Mobile View Switcher
  const btnViewList = document.getElementById('btn-view-list');
  const btnViewMap = document.getElementById('btn-view-map');
  const feedContainer = document.getElementById('feed-container');
  const sidebarContainer = document.getElementById('sidebar-container');

  if (btnViewList && btnViewMap && feedContainer && sidebarContainer) {
    btnViewList.addEventListener('click', () => {
      btnViewList.classList.add('bg-brand-green', 'text-surface');
      btnViewList.classList.remove('text-ink-muted');
      btnViewMap.classList.remove('bg-brand-green', 'text-surface');
      btnViewMap.classList.add('text-ink-muted');

      feedContainer.classList.remove('hidden');
      sidebarContainer.classList.add('hidden', 'lg:flex');
    });

    btnViewMap.addEventListener('click', () => {
      btnViewMap.classList.add('bg-brand-green', 'text-surface');
      btnViewMap.classList.remove('text-ink-muted');
      btnViewList.classList.remove('bg-brand-green', 'text-surface');
      btnViewList.classList.add('text-ink-muted');

      feedContainer.classList.add('hidden');
      sidebarContainer.classList.remove('hidden');
      sidebarContainer.classList.add('flex');
      window.dispatchEvent(new CustomEvent('map:invalidate'));
    });
  }

  // Handle click on "🗺️ Mapa" button in cards
  document.querySelectorAll('[data-locate-id]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = btn.getAttribute('data-locate-id');
      if (!id) return;

      // If mobile view where feed is visible and sidebar is hidden, switch to map
      if (btnViewMap && sidebarContainer && sidebarContainer.classList.contains('hidden')) {
        btnViewMap.click();
      }

      setTimeout(() => {
        window.dispatchEvent(new CustomEvent('map:focus-marker', { detail: { id } }));
      }, 100);
    });
  });

  const dateGroups = document.querySelectorAll('.date-group') as NodeListOf<HTMLElement>;
  const activeCountEl = document.getElementById('active-count');
  const emptyStateEl = document.getElementById('empty-search-state');

  let searchVal = '';
  let activeSource = 'all';
  let activeCategory = 'all';
  let activeLocation = 'all';
  let maxPrice = 600000;
  let minRooms = 0;
  let minBaths = 0;
  let needGarage = false;
  let needStorage = false;
  let needTerrace = false;
  let needPool = false;
  let needElevator = false;

  function updateFilters() {
    let visibleCount = 0;

    dateGroups.forEach(group => {
      const cards = group.querySelectorAll('.opportunity-card') as NodeListOf<HTMLElement>;
      let groupHasMatches = false;

      cards.forEach(card => {
        const text = card.getAttribute('data-text') || '';
        const location = card.getAttribute('data-location') || '';
        const barrio = card.getAttribute('data-barrio') || '';
        const sourceKind = card.getAttribute('data-source-kind') || '';
        const type = card.getAttribute('data-type') || '';

        const cardPriceAttr = card.getAttribute('data-precio-min');
        const cardRoomsAttr = card.getAttribute('data-habitaciones-min');
        const cardBathsAttr = card.getAttribute('data-banos-min');
        const hasGarageAttr = card.getAttribute('data-garaje') === 'true';
        const hasStorageAttr = card.getAttribute('data-trastero') === 'true';
        const hasTerraceAttr = card.getAttribute('data-terraza') === 'true';
        const hasPoolAttr = card.getAttribute('data-piscina') === 'true';
        const hasElevatorAttr = card.getAttribute('data-ascensor') === 'true';

        const cardPrice = cardPriceAttr ? parseInt(cardPriceAttr, 10) : null;
        const cardRooms = cardRoomsAttr ? parseInt(cardRoomsAttr, 10) : null;
        const cardBaths = cardBathsAttr ? parseInt(cardBathsAttr, 10) : null;

        const matchesSearch = text.includes(searchVal.toLowerCase()) || barrio.toLowerCase().includes(searchVal.toLowerCase());
        const matchesSource = activeSource === 'all' || sourceKind === activeSource;
        const matchesCategory = activeCategory === 'all' || type === activeCategory;

        let matchesLocation = false;
        if (activeLocation === 'all') {
          matchesLocation = true;
        } else {
          if (activeLocation === 'Oleiros') {
            matchesLocation = location === 'Oleiros' || location.includes('Perillo') || location.includes('Santa Cruz');
          } else if (activeLocation === 'Culleredo') {
            matchesLocation = location === 'Culleredo' || location.includes('O Burgo') || location.includes('O Temple');
          } else {
            matchesLocation = location === activeLocation;
          }
        }

        const matchesPrice = maxPrice === 600000 || (cardPrice !== null && cardPrice <= maxPrice);
        const matchesRooms = minRooms === 0 || (cardRooms !== null && cardRooms >= minRooms);
        const matchesBaths = minBaths === 0 || (cardBaths !== null && cardBaths >= minBaths);
        const matchesGarage = !needGarage || hasGarageAttr;
        const matchesStorage = !needStorage || hasStorageAttr;
        const matchesTerrace = !needTerrace || hasTerraceAttr;
        const matchesPool = !needPool || hasPoolAttr;
        const matchesElevator = !needElevator || hasElevatorAttr;

        if (
          matchesSearch &&
          matchesSource &&
          matchesCategory &&
          matchesLocation &&
          matchesPrice &&
          matchesRooms &&
          matchesBaths &&
          matchesGarage &&
          matchesStorage &&
          matchesTerrace &&
          matchesPool &&
          matchesElevator
        ) {
          card.style.display = 'flex';
          groupHasMatches = true;
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      group.style.display = groupHasMatches ? 'flex' : 'none';
    });

    if (activeCountEl) {
      activeCountEl.textContent = String(visibleCount);
    }

    if (emptyStateEl) {
      emptyStateEl.classList.toggle('hidden', visibleCount > 0);
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchVal = (e.target as HTMLInputElement).value;
      updateFilters();
    });
  }

  sourceFilters.forEach(btn => {
    btn.addEventListener('click', () => {
      sourceFilters.forEach(b => {
        b.classList.remove('bg-brand-green', 'text-surface');
        b.classList.add('text-ink-muted', 'hover:bg-surface-hover');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.remove('text-ink-muted', 'hover:bg-surface-hover');
      btn.classList.add('bg-brand-green', 'text-surface');
      btn.setAttribute('aria-pressed', 'true');
      activeSource = btn.getAttribute('data-filter-source') || 'all';
      updateFilters();
    });
  });

  categoryFilters.forEach(btn => {
    btn.addEventListener('click', () => {
      categoryFilters.forEach(b => {
        b.classList.remove('bg-brand-green-soft', 'text-brand-green', 'border-brand-green/20');
        b.classList.add('bg-surface', 'text-ink-muted', 'border-border-soft');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.remove('bg-surface', 'text-ink-muted', 'border-border-soft');
      btn.classList.add('bg-brand-green-soft', 'text-brand-green', 'border-brand-green/20');
      btn.setAttribute('aria-pressed', 'true');
      activeCategory = btn.getAttribute('data-filter-category') || 'all';
      updateFilters();
    });
  });

  locationFilters.forEach(btn => {
    btn.addEventListener('click', () => {
      locationFilters.forEach(b => {
        b.classList.remove('bg-brand-green-soft', 'text-brand-green', 'border-brand-green/20');
        b.classList.add('bg-surface', 'text-ink-muted', 'border-border-soft');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.remove('bg-surface', 'text-ink-muted', 'border-border-soft');
      btn.classList.add('bg-brand-green-soft', 'text-brand-green', 'border-brand-green/20');
      btn.setAttribute('aria-pressed', 'true');
      activeLocation = btn.getAttribute('data-filter-location') || 'all';
      updateFilters();
    });
  });

  if (priceRange && priceDisplay) {
    priceRange.addEventListener('input', (e) => {
      const val = parseInt((e.target as HTMLInputElement).value, 10);
      maxPrice = val;
      if (val === 600000) {
        priceDisplay.textContent = 'Sin límite';
      } else {
        priceDisplay.textContent = `< ${val.toLocaleString('es-ES')} €`;
      }
      updateFilters();
    });
  }

  roomFilters.forEach(btn => {
    btn.addEventListener('click', () => {
      roomFilters.forEach(b => {
        b.classList.remove('bg-brand-green', 'text-surface');
        b.classList.add('text-ink-muted', 'hover:bg-surface-hover');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.remove('text-ink-muted', 'hover:bg-surface-hover');
      btn.classList.add('bg-brand-green', 'text-surface');
      btn.setAttribute('aria-pressed', 'true');
      minRooms = parseInt(btn.getAttribute('data-filter-rooms') || '0', 10);
      updateFilters();
    });
  });

  bathFilters.forEach(btn => {
    btn.addEventListener('click', () => {
      bathFilters.forEach(b => {
        b.classList.remove('bg-brand-green', 'text-surface');
        b.classList.add('text-ink-muted', 'hover:bg-surface-hover');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.remove('text-ink-muted', 'hover:bg-surface-hover');
      btn.classList.add('bg-brand-green', 'text-surface');
      btn.setAttribute('aria-pressed', 'true');
      minBaths = parseInt(btn.getAttribute('data-filter-baths') || '0', 10);
      updateFilters();
    });
  });

  filterGarage?.addEventListener('change', (e) => {
    needGarage = (e.target as HTMLInputElement).checked;
    updateFilters();
  });
  filterStorage?.addEventListener('change', (e) => {
    needStorage = (e.target as HTMLInputElement).checked;
    updateFilters();
  });
  filterTerrace?.addEventListener('change', (e) => {
    needTerrace = (e.target as HTMLInputElement).checked;
    updateFilters();
  });
  filterPool?.addEventListener('change', (e) => {
    needPool = (e.target as HTMLInputElement).checked;
    updateFilters();
  });
  filterElevator?.addEventListener('change', (e) => {
    needElevator = (e.target as HTMLInputElement).checked;
    updateFilters();
  });
</script>
