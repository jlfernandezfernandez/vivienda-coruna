---
import '../../styles/global.css';
import Layout from '../../layouts/Layout.astro';
import CoverageMap from '../../components/CoverageMap.astro';
import { MUNICIPALITIES, resolveMunicipality, slugify, webBase } from '../../../scripts/lib/municipios.mjs';
import { getDatabase, getAllOpportunities, getAllGestoras, getAllCooperatives, getMapFeatures } from '../../../scripts/lib/db.mjs';

export function getStaticPaths() {
  const db = getDatabase();
  const opportunities = getAllOpportunities(db, 150);
  const cooperatives = getAllCooperatives(db);
  const gestoras = getAllGestoras(db);
  const allMarkers = getMapFeatures(db, webBase('/vivienda-coruna'));

  return MUNICIPALITIES.map((municipality) => ({
    params: { slug: slugify(municipality) },
    props: {
      municipality,
      opportunities: opportunities.filter((o) => resolveMunicipality(o.location) === municipality),
      cooperatives: cooperatives.filter((c) => c.municipality === municipality),
      promotions: gestoras.flatMap((g) =>
        g.promotions
          .filter((p) => resolveMunicipality(p.location) === municipality)
          .map((p) => ({ gestora: g, promo: p }))
      ),
      muniMarkers: allMarkers.filter((m) => m.municipality === municipality),
    },
  }));
}

const { municipality, opportunities, cooperatives, promotions, muniMarkers = [] } = Astro.props;
const base = webBase(import.meta.env.BASE_URL);
const total = opportunities.length + cooperatives.length + promotions.length;

const pageTitle = `Cooperativas y obra nueva en ${municipality} | Vivienda Coruña`;
const pageDescription = `Actividad detectada en ${municipality}: cooperativas del Rexistro oficial, promociones de obra nueva y señales en prensa y fuentes oficiales.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="mx-auto max-w-4xl px-4 sm:px-6">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs font-semibold text-ink-muted mb-5" aria-label="Miga de pan">
      <a href={base} class="hover:text-brand-green transition-colors">Novedades</a>
      <span class="text-border-strong">/</span>
      <a href={`${base}mapa`} class="hover:text-brand-green transition-colors">Municipios</a>
      <span class="text-border-strong">/</span>
      <span class="text-ink font-bold">{municipality}</span>
    </nav>

    <!-- Header -->
    <div class="mb-8 border-b border-border-soft pb-6">
      <div class="inline-flex items-center gap-1.5 rounded-lg bg-brand-green-soft px-2.5 py-0.5 text-[11px] font-semibold text-brand-green border border-brand-green/10 mb-3">
        <span class="flex h-1.5 w-1.5 rounded-full bg-brand-green pulse-indicator-ok"></span>
        Área Metropolitana de A Coruña
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-ink md:text-4xl leading-tight">
        Cooperativas y Obra Nueva en {municipality}
      </h1>
      <p class="text-sm md:text-base text-ink-muted mt-3 leading-relaxed">
        {total} {total === 1 ? 'registro detectado' : 'registros detectados'}: {cooperatives.length} cooperativas en registro · {promotions.length} promociones de gestoras · {opportunities.length} señales en prensa y boletines oficiales.
      </p>
    </div>

    <!-- Interactive Municipal Map (if there are markers) -->
    {muniMarkers.length > 0 && (
      <div class="mb-10">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-base font-bold text-ink flex items-center gap-2">
            <span>Ubicaciones en {municipality}</span>
            <span class="inline-flex items-center justify-center px-2 py-0.5 rounded-full bg-brand-green-soft text-brand-green text-[11px] font-bold">
              {muniMarkers.length}
            </span>
          </h2>
          <span class="text-xs text-ink-muted">Haz clic en los puntos para ver detalles</span>
        </div>
        <CoverageMap markers={muniMarkers} heightClass="h-[300px] sm:h-[360px]" mapId={`map-${slugify(municipality)}`} />
      </div>
    )}

    {total === 0 ? (
      <div class="p-10 text-center rounded-2xl border border-border-soft text-ink-muted bg-surface text-sm">
        Sin actividad detectada todavía en {municipality}.
      </div>
    ) : (
      <div class="flex flex-col gap-10">
        <!-- Registry cooperatives -->
        {cooperatives.length > 0 && (
          <section aria-labelledby="registro-title">
            <h2 id="registro-title" class="text-lg font-bold text-ink mb-4 flex items-center gap-2">
              Cooperativas constituidas
              <span class="inline-flex items-center justify-center px-2.5 py-0.5 rounded-lg bg-brand-green-soft text-brand-green border border-brand-green/10 text-[11px] font-semibold">
                {cooperatives.length}
              </span>
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {cooperatives.map((c) => (
                <div class="border border-border-soft bg-surface p-5 rounded-2xl shadow-premium">
                  <h3 class="text-sm font-bold text-ink capitalize leading-snug mb-2">{c.name.toLowerCase()}</h3>
                  <div class="text-xs text-ink-muted space-y-1">
                    {c.foundedAt && (
                      <p>Constituida el <strong class="text-ink">{new Date(`${c.foundedAt}T00:00:00`).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Madrid' })}</strong></p>
                    )}
                    {c.foundingPartners != null && <p>{c.foundingPartners} socios fundadores</p>}
                    {c.address && <p>📍 {c.address}</p>}
                    {(c.email || c.phone) && (
                      <div class="flex flex-wrap gap-x-3 gap-y-1 pt-2 border-t border-border-soft mt-2">
                        {c.email && (
                          <a href={`mailto:${c.email}`} class="font-semibold text-brand-green hover:underline">✉️ {c.email}</a>
                        )}
                        {c.phone && (
                          <a href={`tel:${String(c.phone).replace(/\s+/g, '')}`} class="font-semibold text-brand-green hover:underline">📞 {c.phone}</a>
                        )}
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Gestora promotions -->
        {promotions.length > 0 && (
          <section aria-labelledby="promos-title">
            <h2 id="promos-title" class="text-lg font-bold text-ink mb-4 flex items-center gap-2">
              Promociones y cooperativas en el municipio
              <span class="inline-flex items-center justify-center px-2.5 py-0.5 rounded-lg bg-brand-green-soft text-brand-green border border-brand-green/10 text-[11px] font-semibold">
                {promotions.length}
              </span>
            </h2>
            <div class="border border-border-soft bg-surface rounded-2xl shadow-premium overflow-hidden">
              <ul class="divide-y divide-border-soft">
                {promotions.map(({ gestora, promo }) => (
                  <li>
                    <a href={`${base}gestora/${gestora.id}`} class="group flex items-center justify-between gap-3 px-5 py-3.5 hover:bg-surface-hover transition-colors">
                      <div class="min-w-0">
                        <span class="text-sm font-bold text-ink group-hover:text-brand-green transition-colors block truncate">{promo.name}</span>
                        <span class="text-[11px] text-ink-light">Gestora: {gestora.name}</span>
                      </div>
                      <div class="flex gap-1.5 flex-shrink-0">
                        {promo.buscaSocios === true && (
                          <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full border bg-status-ok/10 text-brand-green border-status-ok/25">
                            Captación abierta
                          </span>
                        )}
                        <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full border bg-ink-muted/10 text-ink-muted border-border-soft">
                          {promo.status}
                        </span>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}

        <!-- Opportunities -->
        {opportunities.length > 0 && (
          <section aria-labelledby="senales-title">
            <h2 id="senales-title" class="text-lg font-bold text-ink mb-4 flex items-center gap-2">
              Señales en prensa y fuentes oficiales
              <span class="inline-flex items-center justify-center px-2.5 py-0.5 rounded-lg bg-brand-green-soft text-brand-green border border-brand-green/10 text-[11px] font-semibold">
                {opportunities.length}
              </span>
            </h2>
            <div class="border border-border-soft bg-surface rounded-2xl shadow-premium overflow-hidden">
              <ul class="divide-y divide-border-soft">
                {opportunities.map((o) => (
                  <li>
                    <a href={`${base}oportunidad/${o.id}`} class="group flex items-center justify-between gap-3 px-5 py-3.5 hover:bg-surface-hover transition-colors">
                      <div class="min-w-0">
                        <span class="text-sm font-bold text-ink group-hover:text-brand-green transition-colors block truncate">{o.title}</span>
                        <span class="text-[11px] text-ink-light">
                          {o.barrio ? `${o.barrio} · ` : ''}{o.type || 'Señal'} · {o.sourceKind === 'market-alert' ? 'Prensa local' : o.source}
                        </span>
                      </div>
                      <span class="text-[11px] text-ink-light flex-shrink-0">
                        {new Date(o.publishedAt || o.firstSeenAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Europe/Madrid' })}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}
      </div>
    )}
  </div>
</Layout>
