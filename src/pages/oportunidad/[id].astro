---
import '../../styles/global.css';
import Layout from '../../layouts/Layout.astro';
import { api } from '../../lib/api/client.mjs';
import { apiSafe } from '../../lib/api/boundary.mjs';
import { siteBase, statusToneClass } from '../../lib/ui.mjs';

const base = siteBase(import.meta.env.BASE_URL);
const item = await apiSafe(Astro.response, () => api.opportunity(Astro.params.id), { id: '', title: 'Oportunidad no disponible', url: base, source: '', sourceKind: '', publishedAt: null, firstSeenAt: new Date(0).toISOString(), location: null, type: null, status: null, summary: '', events: [] });

const truncate = (s: string, n = 48) => (s && s.length > n ? s.slice(0, n - 1) + '…' : s || '');

// Events timeline — desc by detectedAt
const eventIcons: Record<string, { icon: string; className: string; ring: string }> = {
  new: { icon: '✚', className: 'text-brand-green', ring: 'bg-brand-green-soft border-brand-green/30' },
  status: { icon: '⇄', className: 'text-brand-blue', ring: 'bg-brand-blue-soft border-brand-blue/30' },
  price: { icon: '€', className: 'text-brand-orange', ring: 'bg-brand-orange-soft border-brand-orange/30' },
};
const opportunityEvents = Array.isArray(item.events)
  ? [...item.events].sort((a, b) => new Date(b.detectedAt).getTime() - new Date(a.detectedAt).getTime())
  : [];

const isMarket = item.sourceKind === 'market-alert';
const isWebSearch = item.sourceKind === 'firecrawl-search';
const originalDomain = item.url ? new URL(item.url, Astro.url).hostname.replace(/^www\./, '') : '';
const sourceLabel = isMarket ? 'Prensa local' : isWebSearch ? originalDomain : item.source;

const formatDate = (d: string | null, style: 'long' | 'medium' = 'long') =>
  d
    ? new Date(d).toLocaleDateString('es-ES', { day: 'numeric', month: style, year: 'numeric', timeZone: 'Europe/Madrid' })
    : null;

const publishedLabel = formatDate(item.publishedAt);
const firstSeenLabel = formatDate(item.firstSeenAt);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateListing',
  name: item.title,
  url: item.url,
  ...(item.publishedAt && { datePosted: item.publishedAt }),
  ...(item.location && {
    address: {
      '@type': 'PostalAddress',
      addressLocality: item.location,
      addressRegion: 'A Coruña',
      addressCountry: 'ES',
    },
  }),
};

const pageTitle = `${item.title} | Vivienda Coruña`;
const pageDescription = item.summary || `${item.type || 'Oportunidad'} en ${item.location || 'A Coruña'} — detectada por Vivienda Coruña.`;
---

<Layout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <!-- Breadcrumbs -->
    <nav aria-label="Migas" class="text-xs text-ink-muted mb-5 flex flex-wrap items-center gap-1">
      <a href={base} class="hover:text-brand-green transition-colors font-semibold">Novedades</a>
      <span aria-hidden="true">›</span>
      {publishedLabel && (
        <>
          <span>{publishedLabel}</span>
          <span aria-hidden="true">›</span>
        </>
      )}
      <span class="text-ink-light truncate max-w-[16rem]" title={item.title}>{truncate(item.title)}</span>
    </nav>

    <article class="border border-border-soft bg-surface p-4 sm:p-6 rounded-2xl shadow-premium">
      <!-- Badges -->
      <div class="flex flex-wrap gap-1.5 mb-4">
        {item.type && (
          <span class="inline-flex items-center rounded-lg bg-canvas border border-border-soft px-2.5 py-0.5 text-[11px] font-semibold text-ink-muted">
            {item.type}
          </span>
        )}
        {item.status && (
          <span class={`inline-flex items-center rounded-lg px-2.5 py-0.5 text-[11px] font-semibold whitespace-nowrap ${statusToneClass(item.statusTone)}`}>
            {item.statusLabel || item.status}
          </span>
        )}
      </div>

      <!-- Title -->
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink leading-tight mb-5">
        {item.title}
      </h1>

      <!-- Spec sheet -->
      {(item.precioMin || item.habitacionesMin || item.banosMin || item.totalViviendas || item.garaje || item.trastero || item.terraza) && (
        <div class="border border-border-soft bg-canvas rounded-xl p-4 mb-5">
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
            {item.precioMin && (
              <span class="text-xl font-extrabold text-brand-green sm:text-2xl">
                Desde {item.precioMin.toLocaleString('es-ES')} €
              </span>
            )}
            {item.precioMax && item.precioMax !== item.precioMin && (
              <span class="text-sm font-semibold text-ink-muted">
                hasta {item.precioMax.toLocaleString('es-ES')} €
              </span>
            )}
            {item.habitacionesMin && (
              <span class="text-xs font-semibold text-ink-muted bg-surface px-2 py-1 rounded border border-border-soft">
                🛏️ {item.habitacionesMin} {item.habitacionesMin === 1 ? 'habitación' : 'habitaciones'}
              </span>
            )}
            {item.banosMin && (
              <span class="text-xs font-semibold text-ink-muted bg-surface px-2 py-1 rounded border border-border-soft">
                🛁 {item.banosMin} {item.banosMin === 1 ? 'baño' : 'baños'}
              </span>
            )}
            {item.totalViviendas && (
              <span class="text-xs font-semibold text-ink-muted bg-surface px-2 py-1 rounded border border-border-soft">
                🏢 {item.totalViviendas} viviendas
              </span>
            )}
          </div>
          {(item.garaje || item.trastero || item.terraza) && (
            <div class="flex flex-wrap gap-1.5 mt-3">
              {item.garaje && <span class="bg-surface border border-border-soft px-2 py-0.5 rounded text-[11px] font-semibold text-ink-muted">🚗 Garaje</span>}
              {item.trastero && <span class="bg-surface border border-border-soft px-2 py-0.5 rounded text-[11px] font-semibold text-ink-muted">📦 Trastero</span>}
              {item.terraza && <span class="bg-surface border border-border-soft px-2 py-0.5 rounded text-[11px] font-semibold text-ink-muted">☀️ Terraza</span>}
            </div>
          )}
        </div>
      )}

      <!-- Promotora -->
      {item.promotora && (
        <p class="text-sm text-ink-muted mb-4">
          Promueve: <span class="font-bold text-ink">{item.promotora}</span>
        </p>
      )}

      <!-- Summary -->
      {item.summary && item.summary.trim().length > 0 && item.summary !== item.title && (
        <p class="text-sm sm:text-base text-ink-muted leading-relaxed mb-5">
          {item.summary}
        </p>
      )}

      <!-- Meta -->
      <dl class="border-t border-border-soft pt-4 mb-5 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-xs text-ink-muted">
        {item.location && (
          <div class="flex justify-between sm:justify-start sm:gap-2">
            <dt class="font-bold text-ink">Ubicación</dt>
            <dd>{item.location}</dd>
          </div>
        )}
        {publishedLabel && (
          <div class="flex justify-between sm:justify-start sm:gap-2">
            <dt class="font-bold text-ink">Publicado</dt>
            <dd>{publishedLabel}</dd>
          </div>
        )}
        {firstSeenLabel && (
          <div class="flex justify-between sm:justify-start sm:gap-2">
            <dt class="font-bold text-ink">Detectado</dt>
            <dd>el {firstSeenLabel}</dd>
          </div>
        )}
        <div class="flex justify-between sm:justify-start sm:gap-2">
          <dt class="font-bold text-ink">Fuente</dt>
          <dd>{sourceLabel}</dd>
        </div>
      </dl>

      <!-- CTA -->
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full bg-brand-green text-surface text-center font-bold py-3 px-4 rounded-xl shadow-sm hover:bg-brand-green-hover hover:-translate-y-[1px] active:scale-[0.98] transition-all flex items-center justify-center gap-2 text-sm"
      >
        <span>Ver fuente original</span>
        <svg class="h-4 w-4 stroke-current fill-none stroke-2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
      </a>
    </article>

    <!-- Timeline of changes -->
    {opportunityEvents.length > 0 && (
      <section class="mt-6 border border-border-soft bg-surface p-4 sm:p-6 rounded-2xl shadow-premium" aria-labelledby="timeline-title">
        <h2 id="timeline-title" class="text-base font-bold text-ink mb-4">Línea temporal de cambios</h2>
        <ol class="relative border-l-2 border-border-soft ml-3 space-y-5">
          {opportunityEvents.map((ev) => {
            const meta = eventIcons[ev.kind] || eventIcons.new;
            return (
              <li class="relative pl-6">
                <span class={`absolute -left-[11px] top-0 flex h-5 w-5 items-center justify-center rounded-full border ${meta.ring} ${meta.className} text-[11px] font-bold`} aria-hidden="true">
                  {meta.icon}
                </span>
                <p class="text-xs font-bold text-ink leading-snug">{ev.label || ev.kind}</p>
                <p class="text-[11px] text-ink-light mt-0.5">
                  {new Date(ev.detectedAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Europe/Madrid' })}
                  {ev.newValue && <span class="text-ink-muted"> · {ev.newValue}</span>}
                </p>
              </li>
            );
          })}
        </ol>
      </section>
    )}
  </div>
</Layout>
