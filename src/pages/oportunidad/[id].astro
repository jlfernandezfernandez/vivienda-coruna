---
import '../../styles/global.css';
import Layout from '../../layouts/Layout.astro';
import MortgageSimulator from '../../components/MortgageSimulator.astro';
import ShareButton from '../../components/ShareButton.astro';
import { api } from '../../lib/api/client.mjs';
import { apiSafe } from '../../lib/api/boundary.mjs';
import { siteBase } from '../../lib/ui.mjs';
import { municipalitySlug } from '../../lib/municipios.mjs';
import { statusColors } from '../../lib/statuses.mjs';

const base = siteBase(import.meta.env.BASE_URL);
const item = await apiSafe(
  Astro.response,
  () => api.opportunity(Astro.params.id || ''),
  {
    id: '',
    title: 'Oportunidad no disponible',
    url: base,
    source: '',
    sourceKind: '',
    publishedAt: null,
    firstSeenAt: new Date(0).toISOString(),
    location: null,
    type: null,
    status: null,
    summary: '',
    events: [],
    precioMin: null,
    precioMax: null,
    habitacionesMin: null,
    banosMin: null,
    promotora: null,
    totalViviendas: null,
    garaje: null,
    trastero: null,
    terraza: null,
    piscina: null,
    ascensor: null,
    entregaEstimada: null,
    municipality: null,
    barrio: null,
  }
);

const isMarket = item.sourceKind === 'market-alert';
const sourceLabel = isMarket ? 'Prensa local' : item.source;
const sourceBadgeBg = isMarket
  ? 'bg-brand-orange-soft text-brand-orange border border-brand-orange/15'
  : 'bg-brand-green-soft text-brand-green border border-brand-green/15';

const formatDate = (d: string | null, style: 'long' | 'short' = 'long') =>
  d
    ? new Date(d).toLocaleDateString('es-ES', { day: 'numeric', month: style, year: 'numeric', timeZone: 'Europe/Madrid' })
    : null;

const publishedLabel = formatDate(item.publishedAt);
const firstSeenLabel = formatDate(item.firstSeenAt);
const displayMuni = item.municipality || item.location;
const muniSlug = municipalitySlug(displayMuni);

const mapsQuery = encodeURIComponent(`${item.barrio ? item.barrio + ' ' : ''}${displayMuni || 'A Coruña'} Galicia España`);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateListing',
  name: item.title,
  url: item.url,
  ...(item.publishedAt && { datePosted: item.publishedAt }),
  ...(item.location && {
    address: {
      '@type': 'PostalAddress',
      addressLocality: item.location,
      addressRegion: 'A Coruña',
      addressCountry: 'ES',
    },
  }),
  ...(item.lat && item.lng && {
    geo: {
      '@type': 'GeoCoordinates',
      latitude: item.lat,
      longitude: item.lng,
    },
  }),
};

const pageTitle = `${item.title} | Vivienda Coruña`;
const pageDescription = item.summary || `${item.type || 'Oportunidad'} en ${item.location || 'A Coruña'} — detectada por Vivienda Coruña.`;
---

<Layout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <!-- Breadcrumbs & Share -->
    <div class="flex items-center justify-between gap-3 mb-5">
      <nav class="flex items-center gap-2 text-xs font-semibold text-ink-muted overflow-x-auto no-scrollbar" aria-label="Miga de pan">
        <a href={base} class="hover:text-brand-green transition-colors">Novedades</a>
        <span class="text-border-strong">/</span>
        {muniSlug ? (
          <a href={`${base}municipio/${muniSlug}`} class="hover:text-brand-green transition-colors">{displayMuni}</a>
        ) : (
          <span>{displayMuni}</span>
        )}
        <span class="text-border-strong">/</span>
        <span class="text-ink font-bold truncate max-w-[180px]">{item.nombrePromocion || item.title}</span>
      </nav>

      <ShareButton title={item.title} variant="detail" />
    </div>

    <article class="border border-border-soft bg-surface p-6 sm:p-8 rounded-2xl shadow-premium mb-8">
      <!-- Badges -->
      <div class="flex flex-wrap gap-1.5 mb-4">
        {item.type && (
          <span class="inline-flex items-center rounded-lg bg-canvas border border-border-soft px-2.5 py-0.5 text-[11px] font-semibold text-ink-muted">
            {item.type}
          </span>
        )}
        {item.status && (
          <span class={`inline-flex items-center rounded-lg px-2.5 py-0.5 text-[11px] font-semibold whitespace-nowrap ${statusColors(item.status)}`}>
            {item.status}
          </span>
        )}
        <span class={`inline-flex items-center rounded-lg px-2.5 py-0.5 text-[11px] font-semibold ${sourceBadgeBg}`}>
          {sourceLabel}
        </span>
      </div>

      <!-- Title -->
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink leading-tight mb-4">
        {item.title}
      </h1>

      <!-- Location Highlight -->
      <div class="flex flex-wrap items-center justify-between gap-3 text-xs text-ink-muted mb-5 pb-4 border-b border-border-soft">
        <div class="flex items-center gap-2">
          <span class="text-base">📍</span>
          <span class="font-bold text-ink">
            {item.barrio ? `${item.barrio}, ` : ''}{displayMuni}
          </span>
        </div>
        <div class="flex items-center gap-3 ml-auto">
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="text-brand-green font-bold hover:underline flex items-center gap-1">
            <span>Google Maps</span>
            <svg class="h-3.5 w-3.5 stroke-current fill-none stroke-2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" /></svg>
          </a>
          <a href={`${base}mapa`} class="text-ink font-bold hover:text-brand-green transition-colors">
            Ver en Mapa Metropolitano →
          </a>
        </div>
      </div>

      <!-- Spec sheet -->
      {(item.precioMin || item.habitacionesMin || item.banosMin || item.totalViviendas || item.garaje || item.trastero || item.terraza || item.piscina || item.ascensor || item.entregaEstimada) && (
        <div class="border border-border-soft bg-canvas rounded-xl p-5 mb-6">
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2 mb-3">
            {item.precioMin && (
              <span class="text-2xl font-extrabold text-brand-green sm:text-3xl">
                Desde {item.precioMin.toLocaleString('es-ES')} €
              </span>
            )}
            {item.precioMax && item.precioMax !== item.precioMin && (
              <span class="text-sm font-semibold text-ink-muted">
                hasta {item.precioMax.toLocaleString('es-ES')} €
              </span>
            )}
            {item.habitacionesMin && (
              <span class="text-xs font-semibold text-ink-muted bg-surface px-2.5 py-1 rounded-lg border border-border-soft">
                🛏️ {item.habitacionesMin} {item.habitacionesMin === 1 ? 'habitación' : 'habitaciones'}
              </span>
            )}
            {item.banosMin && (
              <span class="text-xs font-semibold text-ink-muted bg-surface px-2.5 py-1 rounded-lg border border-border-soft">
                🛁 {item.banosMin} {item.banosMin === 1 ? 'baño' : 'baños'}
              </span>
            )}
            {item.totalViviendas && (
              <span class="text-xs font-semibold text-ink-muted bg-surface px-2.5 py-1 rounded-lg border border-border-soft">
                🏢 {item.totalViviendas} viviendas
              </span>
            )}
            {item.entregaEstimada && (
              <span class="text-xs font-semibold text-brand-blue bg-brand-blue-soft px-2.5 py-1 rounded-lg border border-brand-blue/15">
                📅 Entrega: {item.entregaEstimada}
              </span>
            )}
          </div>

          {(item.garaje || item.trastero || item.terraza || item.piscina || item.ascensor) && (
            <div class="flex flex-wrap gap-1.5 pt-2 border-t border-border-soft">
              {item.garaje && <span class="bg-surface border border-border-soft px-2 py-1 rounded-md text-xs font-semibold text-ink">🚗 Garaje</span>}
              {item.trastero && <span class="bg-surface border border-border-soft px-2 py-1 rounded-md text-xs font-semibold text-ink">📦 Trastero</span>}
              {item.terraza && <span class="bg-surface border border-border-soft px-2 py-1 rounded-md text-xs font-semibold text-ink">☀️ Terraza</span>}
              {item.piscina && <span class="bg-surface border border-border-soft px-2 py-1 rounded-md text-xs font-semibold text-ink">🏊 Piscina</span>}
              {item.ascensor && <span class="bg-surface border border-border-soft px-2 py-1 rounded-md text-xs font-semibold text-ink">🛗 Ascensor</span>}
            </div>
          )}
        </div>
      )}

      <!-- Promotora -->
      {item.promotora && (
        <div class="mb-5 p-3.5 rounded-xl bg-surface border border-border-soft flex items-center justify-between">
          <span class="text-xs text-ink-muted">Empresa / Promotora:</span>
          <span class="text-xs font-extrabold text-ink">{item.promotora}</span>
        </div>
      )}

      <!-- Summary -->
      {item.summary && item.summary.trim().length > 0 && item.summary !== item.title && (
        <div class="mb-6">
          <h2 class="text-xs font-bold uppercase tracking-wider text-ink-muted mb-2">Descripción del aviso</h2>
          <p class="text-sm sm:text-base text-ink leading-relaxed">
            {item.summary}
          </p>
        </div>
      )}

      <!-- Meta Table -->
      <dl class="border-t border-border-soft pt-4 mb-6 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5 text-xs text-ink-muted">
        {publishedLabel && (
          <div class="flex justify-between sm:justify-start sm:gap-2">
            <dt class="font-bold text-ink">Publicado:</dt>
            <dd>{publishedLabel}</dd>
          </div>
        )}
        {firstSeenLabel && (
          <div class="flex justify-between sm:justify-start sm:gap-2">
            <dt class="font-bold text-ink">Detectado:</dt>
            <dd>el {firstSeenLabel}</dd>
          </div>
        )}
        <div class="flex justify-between sm:justify-start sm:gap-2">
          <dt class="font-bold text-ink">Fuente:</dt>
          <dd>{sourceLabel}</dd>
        </div>
      </dl>

      <!-- AI disclaimer -->
      {item.enriched && (
        <p class="text-[11px] text-ink-light italic border-l-2 border-border-soft pl-3 mb-6">
          Datos extraídos automáticamente mediante IA a partir de fuentes públicas. Verifica las condiciones en la fuente original.
        </p>
      )}

      <!-- CTA -->
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full bg-brand-green text-surface text-center font-bold py-3.5 px-4 rounded-xl shadow-sm hover:bg-brand-green-hover hover:-translate-y-0.5 active:scale-[0.98] transition-all flex items-center justify-center gap-2 text-sm"
      >
        <span>Ver anuncio en la fuente original</span>
        <svg class="h-4 w-4 stroke-current fill-none stroke-2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
      </a>
    </article>

    <!-- Embedded Mortgage & Financial Simulator -->
    <div class="mb-10">
      <MortgageSimulator
        initialPrice={item.precioMin || 225000}
        isCooperative={item.type === 'Cooperativa'}
        title={`Simulador de Cuota e Impuestos (${item.nombrePromocion || item.title})`}
      />
    </div>
  </div>
</Layout>
